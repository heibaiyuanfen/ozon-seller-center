        "attributes_json": "[\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Круглая душевая лейка из нержавеющей стали для душа и ванны. Распыляет воду чёткими и мягкими струями благодаря повышенному давлению, что помогает снизить расход воды. Матовая поверхность, износостойкая и ударопрочная конструкция. Рабочая поверхность быстро разбирается для удобного ухода. Лейку удобно держать в руке. Подходит для стандартного подключения 1/2 дюйма.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9455,\n    \"values\": [\n      {\n        \"value\": \"90\"\n      }\n    ],\n    \"_name\": \"包装内产品的宽度，mm\",\n    \"_source\": \"Ширина товара в упаковке, мм\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4180,\n    \"values\": [\n      {\n        \"value\": \"Стальная турбо-лейка для душа, круглая\"\n      }\n    ],\n    \"_name\": \"名称\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4389,\n    \"values\": [\n      {\n        \"value\": \"中国\",\n        \"dictionary_value_id\": 90296\n      }\n    ],\n    \"_name\": \"原产国\",\n    \"_source\": \"系统默认：原产国 中国（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 23171,\n    \"values\": [\n      {\n        \"value\": \"#лейка_для_душа #душевая_лейка #насадка_для_душа #ручная_лейка_для_душа #лейка_для_ванной #душевая_насадка #турбо_лейка #турболейка_для_душа #стальная_лейка_для_душа #лейка_из_нержавеющей_стали #круглая_лейка_для_душа #матовая_лейка_для_душа #лейка_с_мягкой_струей #лейка_с_четкой_струей #лейка_для_экономии_воды #водосберегающая_лейка #прочная_лейка_для_душа #ударопрочная_лейка #износостойкая_лейка #разборная_лейка_для_душа #лейка_с_легким_уходом #лейка_для_домашнего_душа #лейка_для_ванной_комнаты #лейка_для_ежедневного_душа #удобная_лейка_для_душа #лейка_для_замены_душевой #душевая_лейка_для_дома\"\n      }\n    ],\n    \"_name\": \"#主题标签\",\n    \"_source\": \