        "attributes_json": "[\n  {\n    \"complex_id\": 0,\n    \"id\": 10400,\n    \"values\": [\n      {\n        \"value\": \"1 年\",\n        \"dictionary_value_id\": 970716397\n      }\n    ],\n    \"_name\": \"保证\",\n    \"_source\": \"系统默认：保证 1 年（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6318,\n    \"values\": [\n      {\n        \"value\": \"108\"\n      }\n    ],\n    \"_name\": \"灯管数量，个\",\n    \"_source\": \"Количество ламп, шт\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6605,\n    \"values\": [\n      {\n        \"value\": \"90\"\n      }\n    ],\n    \"_name\": \"宽度，毫米\",\n    \"_source\": \"Ширина, мм\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 5269,\n    \"values\": [\n      {\n        \"value\": \"IP65\",\n        \"dictionary_value_id\": 83671\n      }\n    ],\n    \"_name\": \"防护等级\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 85,\n    \"values\": [\n      {\n        \"value\": \"Нет бренда\",\n        \"dictionary_value_id\": 126745801\n      }\n    ],\n    \"_name\": \"品牌\",\n    \"_source\": \"系统锁定：无品牌\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4384,\n    \"values\": [\n      {\n        \"value\": \"солнечный светильник\"\n      }\n    ],\n    \"_name\": \"配套\",\n    \"_source\": \"AI映射页面事实：В комплект входит 1 солнечная лампа\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4180,\n    \"values\": [\n      {\n        \"value\": \"GardLuma уличный LED-светильник на солнечной батарее, 108 ламп\"\n      }\n    ],\n    \"_name\": \"名称\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9802,\n    \"values\": [\n      {\n        \"value\": \"228\"\n      }\n    ],\n    \"_name\": \"长度，毫米\",\n    \"_source\": \"Длина, мм\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4383,\n    \"values\": [\n      {\n        \"value\": \"224.0\"\n      }\n    ],\n    \"_name\": \"商品重量，克\",\n    \"_source\": \"自动工作台：商品净重\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6315,\n    \"values\": [\n      {\n        \"value\": \"LED\",\n        \"dictionary_value_id\": 1353\n      }\n    ],\n    \"_name\": \"底座类型\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 11650,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"原厂包装数量\",\n    \"_source\": \"系统默认：原厂包装数量 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6319,\n    \"values\": [\n      {\n        \"value\": \"10\"\n      }\n    ],\n    \"_name\": \"麦克斯。灯功率，W\",\n    \"_source\": \"Макс. мощность ламп, Вт\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Уличный светильник GardLuma со светодиодными лампами и питанием от солнечной батареи. Модель оснащена 108 лампами, максимальная мощность — 10 Вт. Датчики движения и освещенности обеспечивают автоматическое включение и выключение, также предусмотрено дистанционное управление. Доступны режим постоянного освещения, режим слабого света с усилением при обнаружении движения и режим включения яркого света только при фиксации движения. После срабатывания датчика яркий свет работает около 20 секунд. Светильник подходит для сада, двора, забора, бассейна, дорожек, лестниц и наружных стен. Работает без подключения к электросети: солнечная панель заряжается днем, а продолжительность освещения зависит от интенсивности солнечного света и погодных условий. Корпус защищен от пыли и воды, степень защиты — IP65. Материал плафона — ABS-пластик. Предусмотрено напольное и настенное крепление. Цвет: желтый, матовый черный. Размер: 90×228 мм. В комплекте — 1 солнечный светильник. Гарантия — 3 месяца. Перед первым использованием снимите защитную пленку с солнечной панели, установите светильник в месте с достаточным солнечным освещением и переведите переключатель в положение «Вкл».\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8962,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"一个商品中的件数\",\n    \"_source\": \"系统默认：一个商品中的件数 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4389,\n    \"values\": [\n      {\n        \"value\": \"中国\",\n        \"dictionary_value_id\": 90296\n      }\n    ],\n    \"_name\": \"原产国\",\n    \"_source\": \"系统默认：原产国 中国（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9048,\n    \"values\": [\n      {\n        \"value\": \"AUTO-20260915-9CD01F-526-4\"\n      }\n    ],\n    \"_name\": \"型号名称（针对合并为一张商品卡片）\",\n    \"_source\": \"人工填写：型号名称（合并多变体）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 23171,\n    \"values\": [\n      {\n        \"value\": \"#уличный_светильник #солнечный_уличный_светильник #солнечный_садовый_светильник #уличный_солнечный_фонарь #солнечная_лампа_уличная #солнечный_фонарь #уличный_фонарь #садовый_фонарь #садовый_светильник #лампа_на_солнечной_батарее #светильник_на_солнце #уличный_led_светильник #светодиодный_фонарь #светодиодная_лампа_улица #фонарь_датчик_движения #лампа_с_датчиком_движения #лампа_с_датчиком_света #уличный_фонарь_с_датчиком #светильник_с_датчиком_света #освещение_для_сада #освещение_для_дачи #свет_для_двора #подсветка_забора #подсветка_дорожки #подсветка_лестницы #освещение_бассейна #настенный_уличный_светильник #напольный_уличный_светильник #светильник_для_стены\"\n      }\n    ],\n    \"_name\": \"#主题标签\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6326,\n    \"values\": [\n      {\n        \"value\": \"自动开机\",\n        \"dictionary_value_id\": 11841\n      },\n      {\n        \"value\": \"自动关机\",\n        \"dictionary_value_id\": 11842\n      },\n      {\n        \"value\": \"遥控\",\n        \"dictionary_value_id\": 11844\n      },\n      {\n        \"value\": \"带运动传感器\",\n        \"dictionary_value_id\": 971360956\n      },\n      {\n        \"value\": \"带光传感器\",\n        \"dictionary_value_id\": 971360957\n      }\n    ],\n    \"_name\": \"固定装置的