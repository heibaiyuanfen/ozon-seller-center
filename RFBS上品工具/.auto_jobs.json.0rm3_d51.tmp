alue_id\": 970716397\n      }\n    ],\n    \"_name\": \"保证\",\n    \"_source\": \"系统默认：保证 1 年（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 5269,\n    \"values\": [\n      {\n        \"value\": \"IP65\",\n        \"dictionary_value_id\": 83671\n      }\n    ],\n    \"_name\": \"防护等级\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 23171,\n    \"values\": [\n      {\n        \"value\": \"#фасадный_светильник #уличный_светильник #солнечный_светильник #фонарь_на_солнечной_батарее #светодиодный_фонарь #светильник_с_датчиком #настенный_уличный_светильник #светильник_для_фасада #фонарь_для_двора #освещение_участка #освещение_двора #подсветка_фасада #уличное_освещение_дома #светильник_для_сада #светильник_для_дачи #уличный_фонарь_для_дома #фонарь_для_сада #наружный_светильник #фасадный_фонарь #садовый_светильник #светильник_с_пультом #светильник_с_датчиком_света #автоматический_фонарь #пластиковый_светильник #водостойкий_фонарь #светильник_без_сети #настенный_фонарь #врезной_светильник #черный_фасадный_светильник\"\n      }\n    ],\n    \"_name\": \"#主题标签\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8383,\n    \"values\": [\n      {\n        \"value\": \"800\"\n      }\n    ],\n    \"_name\": \"光通量，Lm\",\n    \"_source\": \"Световой поток, Лм\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4389,\n    \"values\": [\n      {\n        \"value\": \"中国\",\n        \"dictionary_value_id\": 90296\n      }\n    ],\n    \"_name\": \"原产国\",\n    \"_source\": \"系统默认：原产国 中国（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Фасадный светильник Live home предназначен для уличного освещения двора, участка, сада и фасада дома. Модель работает от солнечной батареи, автоматически включается и выключается, а датчик движения помогает активировать освещение при обнаружении движущихся объектов. Управление также доступно с помощью пульта. Светильник оснащён светодиодами: 120 ламп, максимальная мощность — 15 Вт, световой поток — 800 лм, температура света — 6500 К. Площадь освещения составляет до 20 м². Корпус выполнен из ABS-пластика, цвет — чёрно-серый. Предусмотрена защита от пыли и влаги, степень защиты — IP65. Крепление — настенное или врезное. Размеры: высота 12 см, ширина 55 мм, длина 145 мм. Тип цоколя — без цоколя. Напряжение питания — 3,7 В. В комплекте: светильник и пульт управления.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4383,\n    \"values\": [\n      {\n        \"value\": \"429.0\"\n      }\n    ],\n    \"_name\": \"商品重量，克\",\n    \"_source\": \"自动工作台：商品净重\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9802,\n    \"values\": [\n      {\n        \"value\": \"145\"\n      }\n    ],\n    \"_name\": \"长度，毫米\",\n    \"_source\": \"Длина, мм\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6317,\n    \"values\": [\n      {\n        \"value\": \"发光二极管\",\n        \"dictionary_value_id\": 1896\n      }\n    ],\n    \"_name\": \"灯的类型\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 5788,\n    \"values\": [\n      {\n        \"value\": \"水密性\",\n        \"dictionary_value_id\": 970668335\n      },\n      {\n        \"value\": \"防尘和防潮\",\n        \"dictionary_value_id\": 970668337\n      }\n    ],\n    \"_name\": \"保护、房屋的特点\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6315,\n    \"values\": [\n      {\n        \"value\": \"无底座\",\n        \"dictionary_value_id\": 286159581\n      }\n    ],\n    \"_name\": \"底座类型\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 12138,\n    \"values\": [\n      {\n        \"value\": \"是的\",\n        \"dictionary_value_id\": 970701879\n      }\n    ],\n    \"_name\": \"全套灯泡\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id