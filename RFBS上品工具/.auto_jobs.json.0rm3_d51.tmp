            "name_ru": "Ширина/диаметр формы, см",
            "description_ru": "Можно указать только целое число или десятичную дробь. Разделитель — точка.",
            "group_name_ru": ""
          },
          {
            "id": 10400,
            "attribute_complex_id": 0,
            "name": "保证",
            "description": "制造商对产品质量负责的期间。 并且买方可以申请保修案件的退款。 从下拉列表中选择一个值。",
            "type": "String",
