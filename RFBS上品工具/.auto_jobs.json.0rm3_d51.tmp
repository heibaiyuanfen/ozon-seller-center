          {
            "id": 8229,
            "attribute_complex_id": 0,
            "name": "类型",
            "description": "从列表中选择最合适的产品类型。 这些类型参与了Ozon网站上的产品分类。 要正确指定类型，请在Ozon网站上找到与您相似的产品，并在此字段中指定相同的类型。",
            "type": "String",
            "is_collection": false,
            "is_required": true,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 1960,
            "category_dependent": true,
            "complex_is_collection": false,
            "name_ru": "Тип",
            "description_ru": "Выберите из списка наиболее подходящий тип товара. Типы участвуют в распределении товаров по категориям на сайте Ozon. Чтобы правильно указать тип, найдите на сайте Ozon товары, похожие на ваш, и укажите в этом поле такой же тип.",
            "group_name_ru": ""
          },
          {
            "id": 4382,
            "attribute_complex_id": 0,
            "name": "尺寸，毫米",
            "description": "商品不带包装的尺寸（以毫米为单位）。填写格式：长x宽x高，其中长为长度，宽为宽度，高为高度。不含计量单位。例如：70x60x15。",
            "type": "String",
            "is_collection": false,
            "is_required": false,
            "is_aspect": true,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 0,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Размеры, мм",
            "description_ru": "Размеры сторон товара без упаковки в миллиметрах. Формат заполнения: ДхШхВ, где Д - длина, Ш - ширина, В - высота. Без единиц измерения. Пример: 70х60х15.",
            "group_name_ru": ""
          },
          {
            "id": 22273,
            "attribute_complex_id": 100001,
            "name": "臭氧。视频：视频产品",
            "description": "指定视频中显示的产品。 列出以逗号分隔的SKU（不超过5）。",
            "type": "String",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
