        "attribute_definitions": [
          {
            "id": 22126,
            "attribute_complex_id": 0,
            "name": "总数,pcs",
            "description": "如果您销售多个包装，请指定所有包装中的总数量。 例如，如果您销售2包5件商品，请指定10",
            "type": "Integer",
            "is_collection": false,
            "is_required": false,
