\"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"原厂包装数量\",\n    \"_source\": \"系统默认：原厂包装数量 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4383,\n    \"values\": [\n      {\n        \"value\": \"693\"\n      }\n    ],\n    \"_name\": \"商品重量，克\",\n    \"_source\": \"自动工作台：商品净重\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9048,\n    \"values\": [\n      {\n        \"value\": \"AUTO-20260902-513B7D\"\n      }\n    ],\n    \"_name\": \"型号名称（针对合并为一张商品卡片）\",\n    \"_source\": \"人工填写：型号名称（合并多变体）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9802,\n    \"values\": [\n      {\n        \"value\": \"325\"\n      }\n    ],\n    \"_name\": \"长度，毫米\",\n    \"_source\": \"Длина, мм\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10400,\n    \"values\": [\n      {\n        \"value\": \"1 年\",\n        \"dictionary_value_id\": 970716397\n      }\n    ],\n    \"_name\": \"保证\",\n    \"_source\": \"系统默认：保证 1 年（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Слесарный молоток VIRA предназначен для слесарных работ. Боек весом 500 г выполнен из углеродистой стали CS45, форма бойка — квадратная. Рабочая часть плотно соединена с рукояткой из стеклопластика. Покрытие из термопластичной резины TPR мягкое на ощупь и помогает надежно удерживать инструмент в руке. Длина молотка — 325 мм, общий вес — 690 г. Перед использованием убедитесь в целостности и исправности инструмента. Работайте в свободном, незахламленном месте, крепко удерживайте молоток и не допускайте нахождения людей в опасной близости.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10097,\n    \"values\": [\n      {\n        \"value\": \"Красно-чёрная\"\n      }\n    ],\n    \"_name\": \"颜色名称\",\n    \"_source\": \"AI图片证据，置信度 99%：图片1：На фотографии видна рукоятка с красной внешней частью и чёрными вставками.\"\n  },\n  {\n    \"complex_id\": 0,\