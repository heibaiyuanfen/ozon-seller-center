            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Марка ТС",
            "description_ru": "Марку автомобиля следует указать, если товар принадлежит конкретному бренду или разработан специально для него. Если же товар универсальный и подходит ко всем маркам, то оставьте эту характеристику пустой.",
            "group_name_ru": "Технические свойства"
          },
          {
            "id": 23249,
            "attribute_complex_id": 0,
            "name": "统一计量单位中的商品数量",
            "description": "UEI是一个统一的计量单位。 必须根据当地立法规定在白俄罗斯共和国领土上销售货物。 表示每个SKU的件数。 您只能指定一个整数。",
            "type": "Decimal",
