            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "技术参数",
            "group_id": 108,
            "dictionary_id": 1008,
            "category_dependent": true,
            "complex_is_collection": false,
            "name_ru": "Вид питания",
            "description_ru": "Выберите из списка или укажите вручную. Можно добавить несколько значений через точку с запятой. Если точка с запятой есть в значении атрибута, поместите знак в кавычки \";\".",
            "group_name_ru": "Технические свойства"
          },
          {
            "id": 6324,
            "attribute_complex_id": 0,
