        "attributes_json": "[\n  {\n    \"complex_id\": 0,\n    \"id\": 23171,\n    \"values\": [\n      {\n        \"value\": \"#кистевой_эспандер #эспандер_для_рук #круглый_эспандер #эспандер_бублик #тренажер_для_кистей #тренажер_для_рук #тренажер_для_предплечий #эспандер_для_предплечий #силиконовый_эспандер #ручной_эспандер #спортивный_эспандер #эспандер_для_кистей_рук #тренировка_кистей #тренировка_рук #тренировка_предплечий #упражнения_для_кистей #упражнения_для_рук #упражнения_для_предплечий #развитие_мышц_рук #развитие_предплечий #тренировка_мышц_рук #сжатие_кистей #нагрузка_на_кисти #нагрузка_на_предплечья #упражнения_со_сжатием #тренажер_предплечий #силиконовый_тренажер #инвентарь_для_рук\"\n      }\n    ],\n    \"_name\": \"#主题标签\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Круглый кистевой эспандер для тренировки мышц рук и предплечий. Тренажер имеет две нагрузки: 10 и 15 кг. Нагрузка меняется в зависимости от стороны сжатия, для каждой предусмотрен свой цвет. Изготовлен из силикона. Подходит для выполнения различных упражнений для кистей, рук и предплечий.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4180,\n    \"values\": [\n      {\n        \"value\": \"ЖмиPro Эспандер кистевой круглый для рук 2 в 1, 10–15 кг\"\n      }\n    ],\n    \"_name\": \"名称\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10097,\n    \"values\": [\n      {\n        \"value\": \"сине-бирюзовый\"\n      }\n    ],\n    \"_name\": \"颜色名称\",\n    \"_source\": \"AI图片证据，置信度 99%：图片1：На изображении показан эспандер сине-бирюзового оттенка.\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 11650,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"原厂包装数量\",\n    \"_source\": \"系统默认：原厂包装数量 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4389,\n    \"values\": [