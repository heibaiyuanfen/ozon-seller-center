     \"value\": \"USB Type-A\",\n        \"dictionary_value_id\": 972158190\n      }\n    ],\n    \"_name\": \"连接器 1\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10400,\n    \"values\": [\n      {\n        \"value\": \"1 年\",\n        \"dictionary_value_id\": 970716397\n      }\n    ],\n    \"_name\": \"保证\",\n    \"_source\": \"系统默认：保证 1 年（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Повышающий кабель-переходник со встроенным DC-модулем предназначен для питания роутера и другой электроники от USB-источника. По описанию преобразует входное напряжение USB 5 В в постоянное напряжение 9 В или 12 В. Интерфейсы: USB Type-A и DC 5,5 × 2,1 мм. Проводник изготовлен из меди. Кабель подходит для коммутаторов, датчиков, проектов на Arduino или STM, печатающих устройств, аудио- и телевизионной техники, портативной акустики и промышленного использования. Рабочий диапазон температур: от −40 до +85 °C.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4382,\n    \"values\": [\n      {\n        \"value\": \"120×50×50mm\"\n      }\n    ],\n    \"_name\": \"尺寸，毫米\",\n    \"_source\": \"Размеры, мм\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 85,\n    \"values\": [\n      {\n        \"value\": \"Нет бренда\",\n        \"dictionary_value_id\": 126745801\n      }\n    ],\n    \"_name\": \"品牌\",\n    \"_source\": \"系统锁定：无品牌\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4389,\n    \"values\": [\n      {\n        \"value\": \"中国\",\n        \"dictionary_value_id\": 90296\n      }\n    ],\n    \"_name\": \"原产国\",\n    \"_source\": \"系统默认：原产国 中国（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 23171,\n    \"values\": [\n      {\n        \"value\": \"#повышающий_кабель #кабель_переходник_питания #кабель_преобразователь #переходник_для_роутера #кабель_питания_роутера #адаптер_питания_для_роутера #кабель_для_модема #переходник_для_модема #кабель_для_электроники #переходник_питания #кабель_питания_устройств #адаптер_питания_электроники #кабель_для_коммутатора #питание_сетевого_оборудования #кабель_для_датчиков #кабель_для_arduino #кабель_для_stm #кабель_для_печатающих #кабель_для_аудиотехники #кабель_для_телевизионной #кабель_для_портативной #кабель_для_промышленного #кабель_со_встроенным_модулем #медный_кабель_питания #черный_кабель_питания\"\n      }\n    ],\n    \"_name\": \"#主题标签\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 21652,\n    \"values\": [\n      {\n        \"value\": \"铜\",\n        \"dictionary_value_id\": 971214931\n      }\n    ],\n    \"_name\": \"导体材料\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10935,\n    \"values\": [\n      {\n        \"value\": \"连接器（母头）\",\n        \"dictionary_value_id\": 970781648\n      }\n    ],\n    \"_name\": \"连接器类型 1\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10934,\n    \"values\": [\n      {\n        \"value\": \"直流 5.5 x 2.1 毫米\",\n        \"dictionary_value_id\": 970781583\n      }\n    ],\n    \"_name\": \"连接器 2\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 5948,\n    \"values\": [\n      {\n        \"value\": \"打印设备专用\",\n        \"dictionary_value_id\": 34781\n      },\n      {\n        \"value\": \"网络设备专用\",\n        \"dictionary_value_id\": 34783\n      },\n      {\n        \"value\": \"影音设备专用\",\n        \"dictionary_value_id\": 34785\n      },\n      {\n        \"value\": \"工业用途\",\n        \"dictionary_value_id\": 34791\n      },\n      {\n        \"value\": \"便携音响专用\",\n        \"dictionary_value_id\": 970942174\n      }\n    ],\n    \"_name\": \"用途\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10936,\n    \"values\": [\n      {\n        \"value\": \"连接器（母头）\",\n        \"dicti