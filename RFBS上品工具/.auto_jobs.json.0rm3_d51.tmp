        "attributes_json": "[\n  {\n    \"complex_id\": 0,\n    \"id\": 5309,\n    \"values\": [\n      {\n        \"value\": \"ABS塑料\",\n        \"dictionary_value_id\": 61704\n      },\n      {\n        \"value\": \"钢材\",\n        \"dictionary_value_id\": 62099\n      }\n    ],\n    \"_name\": \"材料\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Регулируемый кистевой эспандер предназначен для тренировок рук, кистей, пальцев, запястий и предплечий. Плавная регулировка сопротивления от 5 до 200 кг позволяет подобрать нагрузку для разных уровней подготовки. Эспандер выполнен из стали и ABS-пластика, оснащен мягкими ручками с пружинами и механическим счетчиком повторений. Подходит для занятий дома, в офисе, спортзале, в поездке или на отдыхе. Может использоваться спортсменами, офисными работниками, взрослыми и детьми, а также для восстановительной гимнастики кистей. Цвет — небесно-голубой. В комплекте: кистевой эспандер с механическим счетчиком.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 23171,\n    \"values\": [\n      {\n        \"value\": \"#эспандер_кистевой #кистевой_эспандер_для_рук #пружинный_эспандер #регулируемый_эспандер #ручной_эспандер #гриппер_для_рук #эспандер_для_хвата #тренажер_для_кисти #тренажер_для_рук #тренажер_для_пальцев #тренажер_для_предплечий #тренажер_для_силы_хвата #эспандер_для_запястий #эспандер_для_фитнеса #эспандер_для_спорта #тренировка_кистей #упражнения_для_хвата #укрепление_предплечий #эспандер_для_офиса #эспандер_в_дорогу #домашний_тренажер_для_рук #тренажер_для_спортсменов #эспандер_для_альпинистов #эспандер_для_теннисистов #эспандер_для_взрослых #эспандер_для_детей #эспандер_со_счетчиком #эспандер_с_мягкими_ручками #тренажер_для_мелкой_моторики #эспандер_для_реабилитации\"\n      }\n    ],\n    \"_name\": \"#主题标签\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \