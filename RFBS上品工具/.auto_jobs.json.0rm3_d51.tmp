 [\n      {\n        \"value\": \"Универсальные салфетки для ежедневной уборки кухни и дома. Изготовлены из плотной микрофибры, хорошо впитывают воду и подходят для удаления следов жира, загрязнений и пыли. Салфетки можно использовать для плиты, столешниц, посуды, стекол, зеркал, мебели, кафеля, смесителей и других поверхностей. Разноцветный набор из 5 салфеток удобен для разделения задач по уборке. Материал мягкий, прочный и устойчивый к многократным стиркам.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4383,\n    \"values\": [\n      {\n        \"value\": \"125\"\n      }\n    ],\n    \"_name\": \"商品重量，克\",\n    \"_source\": \"自动工作台：商品净重\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4389,\n    \"values\": [\n      {\n        \"value\": \"中国\",\n        \"dictionary_value_id\": 90296\n      }\n    ],\n    \"_name\": \"原产国\",\n    \"_source\": \"系统默认：原产国 中国（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 11650,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"原厂包装数量\",\n    \"_source\": \"系统默认：原厂包装数量 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10400,\n    \"values\": [\n      {\n        \"value\": \"1 年\",\n        \"dictionary_value_id\": 970716397\n      }\n    ],\n    \"_name\": \"保证\",\n    \"_source\": \"系统默认：保证 1 年（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8962,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"一个商品中的件数\",\n    \"_source\": \"系统默认：一个商品中的件数 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4067,\n    \"values\": [\n      {\n        \"value\": \"30х30\"\n      }\n    ],\n    \"_name\": \"尺寸，厘米\",\n    \"_source\": \"Размер, см\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6456,\n    \"values\": [\n      {\n        \"value\": \"普遍\",\n        \"dictionary_value_id\": 81863\n      },\n      {\n        \"value\": \"适用于瓷砖和瓷砖\",\n        \"dictionary_v