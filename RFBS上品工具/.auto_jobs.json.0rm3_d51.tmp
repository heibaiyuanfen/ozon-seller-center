            "group_name_ru": ""
          },
          {
            "id": 4967,
            "attribute_complex_id": 0,
            "name": "材料",
            "description": "请从下拉列表中选择一个或多个值，但不能超过5个值。在XLS文件中请用分号(;)分隔变体，且不要添加空格。",
