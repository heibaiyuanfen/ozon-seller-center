    \"id\": 10097,\n    \"values\": [\n      {\n        \"value\": \"черный\"\n      }\n    ],\n    \"_name\": \"颜色名称\",\n    \"_source\": \"AI映射页面事实：В характеристиках указан цвет: черный.\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9048,\n    \"values\": [\n      {\n        \"value\": \"AUTO-20260922-6561E6\"\n      }\n    ],\n    \"_name\": \"型号名称（针对合并为一张商品卡片）\",\n    \"_source\": \"人工填写：型号名称（合并多变体）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6643,\n    \"values\": [\n      {\n        \"value\": \"记忆棉\",\n        \"dictionary_value_id\": 971113445\n      },\n      {\n        \"value\": \"Memory Foam\",\n        \"dictionary_value_id\": 62363\n      }\n    ],\n    \"_name\": \"填充材料\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4383,\n    \"values\": [\n      {\n        \"value\": \"378\"\n      }\n    ],\n    \"_name\": \"商品重量，克\",\n    \"_source\": \"自动工作台：商品净重\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 11650,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"原厂包装数量\",\n    \"_source\": \"系统默认：原厂包装数量 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4180,\n    \"values\": [\n      {\n        \"value\": \"Подушка на стул IKEA, 1 шт, черная\"\n      }\n    ],\n    \"_name\": \"名称\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10096,\n    \"values\": [\n      {\n        \"value\": \"黑色\",\n        \"dictionary_value_id\": 61574\n      }\n    ],\n    \"_name\": \"商品颜色\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Подушка на стул IKEA для комфортного сидения дома, в офисе, автомобиле или на твердой поверхности. Прямоугольная форма, высота 8 см, наполнитель Меморикс и чехол из полиэстера. Анатомическая конструкция помогает поддерживать спину и снижать нагрузку при длительном сидении. Подушка подходит для стула, кресла и автомобильного сиденья. Съемный чехол на молнии удобен в уходе: предусмотрена деликатная стирка. Черный цвет легко сочетается с офисной и домашней мебелью. Изделие гипоаллергенно.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6780,\n    \"values\": [\n      {\n        \"value\": \"精致洗涤\",\n        \"dictionary_value_id\": 81206\n      }\n    ],\n    \"_name\": \"洗涤模式\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10112,\n    \"values\": [\n      {\n        \"value\": \"是的\",\n        \"dictionary_value_id\": 82352\n      }\n    ],\n    \"_name\": \"低过敏性的\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6642,\n    \"values\": [\n      {\n        \"value\": \"聚酯\",\n        \"dictionary_value_id\": 62040\n      }\n    ],\n    \"_name\": \"外壳材质\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8229,\n    \"values\": [\n      {\n        \"value\": \"椅垫\",\n        \"dictionary_value_id\": 92624\n      }\n    ],\n    \"_name\": \"类型\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10009,\n    \"values\": [\n      {\n        \"value\": \"在座椅上\",\n        \"dictionary_value_id\": 970669167\n      }\n    ],\n    \"_name\": \"坐垫应用领域\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6774,\n    \"values\": [\n      {\n        \"value\": \"1\",\n        \"dictionary_value_id\": 45536\n      }\n    ],\n    \"_name\": \"集合中的项数\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  }\n]",
