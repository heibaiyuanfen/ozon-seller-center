        "attribute_definitions": [
          {
            "id": 7204,
            "attribute_complex_id": 0,
            "name": "汽车品牌",
            "description": "如果产品属于特定品牌或专为其设计，则应注明汽车品牌。 如果产品是通用的，适合所有品牌，那么将这个特征留空。",
            "type": "String",
            "is_collection": true,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "技术参数",
            "group_id": 108,
            "dictionary_id": 1438,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Марка ТС",
            "description_ru": "Марку автомобиля следует указать, если товар принадлежит конкретному бренду или разработан специально для него. Если же товар универсальный и подходит ко всем маркам, то оставьте эту характеристику пустой.",
            "group_name_ru": "Технические свойства"
          },
          {
            "id": 4191,
            "attribute_complex_id": 0,
            "name": "简介",
            "description": "商品描述、营销文本",
            "type": "String",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 0,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Аннотация",
            "description_ru": "Описание товара, маркетинговый текст",
            "group_name_ru": ""
          },
          {
            "id": 23446,
            "attribute_complex_id": 0,
            "name": "持有人类别",
            "description": "从列表中选择。您只能指定一个值。",
            "type": "String",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 124413303,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Вид держателя",
            "description_ru": "Выберите из списка. Можно указать только одно значение.",
            "group_name_ru": ""
          },
          {
            "id": 85,
            "attribute_complex_id": 0,
            "name": "品牌",
            "description": "生产产品的品牌名称。 如果产品没有品牌，请使用\"无品牌\"值。",
            "type": "String",
            "is_collection": false,
            "is_required": true,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "基本信息",
            "group_id": 1,
            "dictionary_id": 28732849,
            "category_dependent": true,
            "complex_is_collection": false,
            "name_ru": "Бренд",
            "description_ru": "Наименование бренда, под которым произведен товар. Если товар не имеет бренда, используйте значение \"Нет бренда\".",
            "group_name_ru": "Общие"
          },
          {
            "id": 23536,
            "attribute_complex_id": 0,
            "name": "需要标记代码",
            "description": "如果产品有标记代码(KIZ)，请选择\"是\"。 我们将在每次装运或交货时检查它。 通过Seller API集成时，将参数传递为\"true\" ",
            "type": "Boolean",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 0,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Нужен код маркировки",
            "description_ru": "Выберите «Да», если товар имеет код маркировки (КИЗ). Будем проверять его у каждой отгрузки или поставки. При интеграции через Seller API передавайте параметр как \"true\" ",
            "group_name_ru": ""
          },
          {
            "id": 4384,
            "attribute_complex_id": 0,
            "name": "配套",
            "description": "列出产品中包含的内容：说明，案例，一套电线等。 不要复制其他特征（包中的注释、类型或数量）的值。 如果您正在交付没有额外包裹的物品，请不要填写此说明。 ",
            "type": "String",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 0,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Комплектация",
            "description_ru": "Перечислите, что входит в комплект вместе с товаром: инструкция, чехол, комплект проводов и т.п. Не дублируйте сюда значения других характеристик (аннотацию, тип или количество в упаковке). Если вы поставляете товар без дополнительной комплектации, не заполняйте эту характеристику. ",
            "group_name_ru": ""
          },
          {
            "id": 20408,
            "attribute_complex_id": 0,
            "name": "汽车附件安装类型",
            "description": "从列表中选择。您只能指定一个值。",
            "type": "String",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 119661959,
            "category_dependent": true,
            "complex_is_collection": false,
            "name_ru": "Вид крепления автоаксессуара",
            "description_ru": "Выберите из списка. Можно указать только одно значение.",
            "group_name_ru": ""
          },
          {
            "id": 4383,
            "attribute_complex_id": 0,
            "name": "商品重量，克",
            "description": "无包装产品的重量（净）克每1SKU。 您只能指定整数或十进制数。 分隔符是一个点",
            "type": "Decimal",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 0,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Вес товара, г",
            "description_ru": "Вес товара без упаковки (нетто) в граммах в расчете на 1 SKU. Можно указать только целое число или десятичную дробь. Разделитель — точка",
            "group_name_ru": ""
          },
          {
            "id": 9024,
            "attribute_complex_id": 0,
            "name": "卖家代码",
            "description": "其会计的字母数字产品代码在产品中是唯一的。 它不是EAN/序列号/条形码，也不等于产品型号名称。 这些参数有单独的特征。 卖家的代码不会显示在网站上的产品配置文件中。 它可用于产品名称的自动形成。",
            "type": "String",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 0,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Код продавца",
            "description_ru": "Цифро-буквенный код товара для его учета, является уникальным среди товаров. Не является EAN/серийным номером/штрихкодом, не равен названию модели товара - для этих параметров есть отдельные характеристики. Код продавца не выводится в карточке товара на сайте. Может использоваться при автоматическом формировании названия товара.",
            "group_name_ru": ""
          },
          {
            "id": 8229,
            "attribute_complex_id": 0,
            "name": "类型",
            "description": "从列表中选择最合适的产品类型。 这些类型参与了Ozon网站上的产品分类。 要正确指定类型，请在Ozon网站上找到与您相似的产品，并在此字段中指定相同的类型。",
            "type": "String",
            "is_collection": false,
            "is_required": true,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "基本信息",
            "group_id": 1,
            "dictionary_id": 1960,
            "category_dependent": true,
            "complex_is_collection": false,
            "name_ru": "Тип",
            "description_ru": "Выберите из списка наиболее подходящий тип товара. Типы участвуют в распределении товаров по категориям на сайте Ozon. Чтобы правильно указать тип, найдите на сайте Ozon товары, похожие на ваш, и укажите в этом поле такой же тип.",
            "group_name_ru": "Общие"
          },
          {
            "id": 8790,
            "attribute_complex_id": 8788,
            "name": "PDF 文件",
