        "attributes_json": "[\n  {\n    \"complex_id\": 0,\n    \"id\": 4384,\n    \"values\": [\n      {\n        \"value\": \"3 магнитных переходника для зарядки Type-C, Lightning и Micro-USB; провод Type-C — USB\"\n      }\n    ],\n    \"_name\": \"配套\",\n    \"_source\": \"AI映射页面事实：Комплектация указана в описании товара.\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9048,\n    \"values\": [\n      {\n        \"value\": \"AUTO-20260917-941C74\"\n      }\n    ],\n    \"_name\": \"型号名称（针对合并为一张商品卡片）\",\n    \"_source\": \"人工填写：型号名称（合并多变体）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 7199,\n    \"values\": [\n      {\n        \"value\": \"ABS塑料\",\n        \"dictionary_value_id\": 61704\n      }\n    ],\n    \"_name\": \"材料\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 23171,\n    \"values\": [\n      {\n        \"value\": \"#автомобильный_держатель #держатель_для_телефона #держатель_для_смартфона #автодержатель_для_телефона #держатель_телефона #держатель_в_дефлектор #держатель_на_решетку #держатель_с_беспроводной #держатель_телефона_с_зарядкой #беспроводная_зарядка #зарядка_телефона_в_машине #держатель_с_зарядкой_qi #держатель_смартфона_qi #держатель_с_автоматической #держатель_телефона_с_зажимом #держатель_телефона_с_крюком #поворотный_держатель #держатель_телефона_360 #крепление_телефона #автоаксессуары_для_смартфона #держатель_для_навигации #держатель_для_iphone #держатель_для_android #черный_держатель_для_телефона #держатель_из_abs_пластика\"\n      }\n    ],\n    \"_name\": \"#主题标签\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8415,\n    \"values\": [\n      {\n        \"value\": \"13\"\n      }\n    ],\n    \"_name\": \"长度，厘米\",\n    \"_source\": \"Длина, см\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 20410,\n    \"values\": [\n      {\n        \"value\": \"360度旋转\",\n        \"dictionary_value_id\": 971053322\n      },\n      {\n        \"value\": \"适用于智能手机\",\n        \"dictionary_value_id\": 971053325\n      },\n      {\n        \"value\": \"Qi 无线充电\",\n        \"dictionary_value_id\": 971053318\n      }\n    ],\n    \"_name\": \"持有人特征\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10096,\n    \"values\": [\n      {\n        \"value\": \"黑色\",\n        \"dictionary_value_id\": 61574\n      }\n    ],\n    \"_name\": \"商品颜色\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Автомобильный держатель для телефона Q15 предназначен для установки в воздуховод автомобиля. Крепление с зажимом и крюком помогает зафиксировать смартфон, а автоматическая фиксация подстраивается под его размер. Держатель поддерживает поворот на 360 градусов. Встроенная беспроводная зарядка Qi позволяет заряжать совместимый смартфон без проводов. Подходит для смартфонов с диагональю до 6,7 дюйма, включая устройства iPhone, Xiaomi, Samsung и смартфоны на Android. Особенно удобен для телефонов с поддержкой MagSafe. Корпус выполнен из ABS-пластика, цвет — черный. В комплект входят 3 магнитных переходника для зарядки: Type-C, Lightning и Micro-USB, а также провод Type-C — USB.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4383,\n    \"values\": [\n      {\n        \"value\": \"214.0\"\n      }\n    ],\n    \"_name\": \"商品重量，克\",\n    \"_source\": \"自动工作台：商品净重\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4389,\n    \"values\": [\n      {\n        \"value\": \"中国\",\n        \"dictionary_value_id\": 90296\n      }\n    ],\n    \"_name\": \"原产国\",\n    \"_source\": \"系统默认：原产国 中国（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 85,\n    \"values\": [\n      {\n        \"value\": \"Нет бренда\",\n        \"dictionary_value_id\": 126745801\n      }\n    ],\n    \"_name\": \"品牌\",\n    \"_source\": \"系统锁定：无品牌\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10400,\n    \"values\": [\n      {\n        \"value\": \"1 年\",\n        \"dictionary_value_id\": 970716397\n      }\n    ],\n    \"_name\": \"保证\",\n    \"_source\": \"系统默认：保证 1 年（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4180,\n    \"values\": [\n      {\n        \"value\": \"Автомобильный держатель для телефона Q15 с беспроводной зарядкой\"\n      }\n    ],\n    \"_name\": \"名称\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8416,\n    \"values\": [\n      {\n        \"value\": \"10\"\n      }\n    ],\n    \"_name\": \"宽度，厘米\",\n    \"_source\": \"Ширина, см\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6135,\n    \"values\": [\n      {\n        \"value\": \"6.7\"\n      }\n    ],\n    \"_name\": \"屏幕最大尺寸，英寸\",\n    \"_source\": \"Макс. диагональ, дюймы\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 11650,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"原厂包装数量\",\n    \"_source\": \"系统默认：原厂包装数量 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 23446,\n    \"values\": [\n      {\n        \"value\": \"手机座\",\n        \"dictionary_value_id\": 972879653\n      }\n    ],\n    \"_name\": \"持有人类别\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 21976,\n    \"values\": [\n      {\n        \"value\": \"是的\",\n        \"dictionary_value_id\": 82352\n      }\n    ],\n    \"_name\": \"内置无线充电\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 7212,\n    \"values\": [\n      {\n        \"value\": \"适用于所有型号\",\n        \"dictionary_value_id\": 970688603\n      }\n    ],\n    \"_name\": \"车辆模型\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 20409,\n    \"values\": [\n      {\n        \"value\": \"管\",\n        \"dictionary_value_id\": 971053299\n      }\n    ],\n    \"_name\": \"支架安装位置\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"