        "attributes_json": "[\n  {\n    \"complex_id\": 0,\n    \"id\": 4180,\n    \"values\": [\n      {\n        \"value\": \"Автомобильный магнитный держатель для телефона YCAR15 на присоске\"\n      }\n    ],\n    \"_name\": \"名称\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Автомобильный держатель для телефона YCAR15 с магнитной фиксацией MagSafe и вакуумной присоской. Устанавливается на лобовое стекло или приборную панель без крепления к воздуховоду. Поворотная конструкция на 360 градусов помогает настроить удобный угол обзора для навигации и звонков по громкой связи. Магнитная площадка позволяет быстро установить и снять совместимый смартфон одной рукой. Корпус выполнен из ABS-пластика, силикона и магнита, цвет — черный. Беспроводная зарядка не предусмотрена.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 20408,\n    \"values\": [\n      {\n        \"value\": \"吸盘\",\n        \"dictionary_value_id\": 971053279\n      }\n    ],\n    \"_name\": \"汽车附件安装类型\",\n    \"_source\": \"Вид крепления автоаксессуара + Ozon字典精确匹配\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10096,\n    \"values\": [\n      {\n        \"value\": \"黑色\",\n        \"dictionary_value_id\": 61574\n      }\n    ],\n    \"_name\": \"商品颜色\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10400,\n    \"values\": [\n      {\n        \"value\": \"1 年\",\n        \"dictionary_value_id\": 970716397\n      }\n    ],\n    \"_name\": \"保证\",\n    \"_source\": \"系统默认：保证 1 年（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4383,\n    \"values\": [\n      {\n        \"value\": \"146.0\"\n      }\n    ],\n    \"_name\": \"商品重量，克\",\n    \"_source\": \"自动工作台：商品净重\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 23249,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"