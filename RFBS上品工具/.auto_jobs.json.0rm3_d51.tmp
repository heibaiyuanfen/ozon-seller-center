        "attributes_json": "[\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Автомобильный держатель YCAR предназначен для размещения смартфона в машине. Гравитационная конструкция подходит для смартфонов с диагональю до 7 дюймов. Крепление на присоске можно установить на лобовое стекло или приборную панель. Держатель выполнен из ABS-пластика и силикона, оснащен поворотным механизмом на 360 градусов и регулируемой длинной конструкцией. Подойдет для использования навигации, звонков и прослушивания музыки в поездке. Беспроводная зарядка не предусмотрена.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 85,\n    \"values\": [\n      {\n        \"value\": \"Нет бренда\",\n        \"dictionary_value_id\": 126745801\n      }\n    ],\n    \"_name\": \"品牌\",\n    \"_source\": \"系统锁定：无品牌\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4383,\n    \"values\": [\n      {\n        \"value\": \"211.0\"\n      }\n    ],\n    \"_name\": \"商品重量，克\",\n    \"_source\": \"自动工作台：商品净重\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8416,\n    \"values\": [\n      {\n        \"value\": \"12\"\n      }\n    ],\n    \"_name\": \"宽度，厘米\",\n    \"_source\": \"Ширина, см\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 11650,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"原厂包装数量\",\n    \"_source\": \"系统默认：原厂包装数量 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4180,\n    \"values\": [\n      {\n        \"value\": \"Автомобильный держатель для телефона YCAR на присоске\"\n      }\n    ],\n    \"_name\": \"名称\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8415,\n    \"values\": [\n      {\n        \"value\": \"24\"\n      }\n    ],\n    \"_name\": \"长度，厘米\",\n    \"_source\": \"Длина, см\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10400,\n    \"values\": [\n      {\n        \"value\": \"1 年\