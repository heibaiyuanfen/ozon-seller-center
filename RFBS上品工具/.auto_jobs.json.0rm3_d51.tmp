        "attribute_definitions": [
          {
            "id": 9719,
            "attribute_complex_id": 0,
            "name": "上部淋浴的大小，mm",
            "description": "热带（上部）淋浴的最大尺寸。 如果它是圆形的，写下它的直径，如果是矩形，那么最大边的长度。 您只能指定整数或十进制数。 分隔符是一个点。",
            "type": "Decimal",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "技术参数",
            "group_id": 108,
            "dictionary_id": 0,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Размер верхнего душа, мм",
            "description_ru": "Наибольший размер тропического (верхнего) душа. Если он круглый, запишите его диаметр, если прямоугольный, то длину наибольшей стороны. Можно указать только целое число или десятичную дробь. Разделитель — точка.",
            "group_name_ru": "Технические свойства"
          },
          {
            "id": 9717,
            "attribute_complex_id": 0,
            "name": "喷射模式数量",
            "description": "喷壶、花洒淋浴或侧喷嘴的喷淋模式数量。 如果您正在描述包括喷壶和花洒淋浴的淋浴设备，并且这些设备具有不同数量的喷射模式，请使用最大值。 您只能指定一个整数。",
            "type": "Integer",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "技术参数",
            "group_id": 108,
            "dictionary_id": 0,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Количество режимов струи",
            "description_ru": "Количество режимов струи лейки, тропического душа или боковой форсунки. Если вы описываете душевой комплект, в котором есть лейка и тропический душ, и эти приборы имеют разное количество режимов струи, используйте максимальное значение. Можно указать только целое число.",
            "group_name_ru": "Технические свойства"
          },
          {
            "id": 8229,
            "attribute_complex_id": 0,
            "name": "类型",
            "description": "从列表中选择最合适的产品类型。 这些类型参与了Ozon网站上的产品分类。 要正确指定类型，请在Ozon网站上找到与您相似的产品，并在此字段中指定相同的类型。",
            "type": "String",
            "is_collection": false,
            "is_required": true,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 1960,
            "category_dependent": true,
            "complex_is_collection": false,
            "name_ru": "Тип",
            "description_ru": "Выберите из списка наиболее подходящий тип товара. Типы участвуют в распределении товаров по категориям на сайте Ozon. Чтобы правильно указать тип, найдите на сайте Ozon товары, похожие на ваш, и укажите в этом поле такой же тип.",
            "group_name_ru": ""
          },
          {
            "id": 9454,
            "attribute_complex_id": 0,
            "name": "产品在包装中的长度，mm",
            "description": "",
