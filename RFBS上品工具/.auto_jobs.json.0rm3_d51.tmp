          },
          {
            "id": 85,
            "attribute_complex_id": 0,
            "name": "品牌",
            "description": "生产产品的品牌名称。 如果产品没有品牌，请使用\"无品牌\"值。",
            "type": "String",
            "is_collection": false,
            "is_required": true,
