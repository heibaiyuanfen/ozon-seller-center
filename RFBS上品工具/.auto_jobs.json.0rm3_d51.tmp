            "complex_is_collection": true,
            "name_ru": "Озон.Видео: ссылка",
            "description_ru": "Укажите ссылку на видео (MP4, MOV). Продолжительность от 8 сек до 5 минут, размер файла не более 2ГБ",
            "group_name_ru": ""
          },
          {
            "id": 8229,
            "attribute_complex_id": 0,
            "name": "类型",
            "description": "从列表中选择最合适的产品类型。 这些类型参与了Ozon网站上的产品分类。 要正确指定类型，请在Ozon网站上找到与您相似的产品，并在此字段中指定相同的类型。",
            "type": "String",
            "is_collection": false,
            "is_required": true,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "基本信息",
            "group_id": 1,
            "dictionary_id": 1960,
            "category_dependent": true,
            "complex_is_collection": false,
            "name_ru": "Тип",
            "description_ru": "Выберите из списка наиболее подходящий тип товара. Типы участвуют в распределении товаров по категориям на сайте Ozon. Чтобы правильно указать тип, найдите на сайте Ozon товары, похожие на ваш, и укажите в этом поле такой же тип.",
            "group_name_ru": "Общие"
          },
          {
            "id": 85,
            "attribute_complex_id": 0,
            "name": "品牌",
            "description": "生产产品的品牌名称。 如果产品没有品牌，请使用\"无品牌\"值。",
            "type": "String",
            "is_collection": false,
            "is_required": true,
