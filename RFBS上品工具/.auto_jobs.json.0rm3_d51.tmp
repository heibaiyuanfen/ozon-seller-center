    }\n    ],\n    \"_name\": \"名称\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Паровая щетка для ухода за шерстью и кожей домашних животных. Оснащена кнопкой подачи холодного пара и силиконовыми щетинками для расчесывания и массажа. Подходит для кошек, собак, кроликов, морских свинок и других грызунов. Щетка с 84 зубьями средней жесткости помогает ухаживать за длинной, короткой и гладкой шерстью. Корпус выполнен из ABS-пластика и силикона, цвет — бежевый.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8229,\n    \"values\": [\n      {\n        \"value\": \"动物梳子\",\n        \"dictionary_value_id\": 95249\n      }\n    ],\n    \"_name\": \"类型\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 5968,\n    \"values\": [\n      {\n        \"value\": \"头发和皮肤护理\",\n        \"dictionary_value_id\": 57925\n      }\n    ],\n    \"_name\": \"护理类型\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4958,\n    \"values\": [\n      {\n        \"value\": \"猫咪用品\",\n        \"dictionary_value_id\": 33754\n      },\n      {\n        \"value\": \"对于狗\",\n        \"dictionary_value_id\": 33746\n      },\n      {\n        \"value\": \"对于啮齿动物\",\n        \"dictionary_value_id\": 33755\n      }\n    ],\n    \"_name\": \"专为\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  }\n]",
