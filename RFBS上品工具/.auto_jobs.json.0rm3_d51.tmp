        "attributes_json": "[\n  {\n    \"complex_id\": 0,\n    \"id\": 10096,\n    \"values\": [\n      {\n        \"value\": \"黑色\",\n        \"dictionary_value_id\": 61574\n      }\n    ],\n    \"_name\": \"商品颜色\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 85,\n    \"values\": [\n      {\n        \"value\": \"Нет бренда\",\n        \"dictionary_value_id\": 126745801\n      }\n    ],\n    \"_name\": \"品牌\",\n    \"_source\": \"系统锁定：无品牌\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6135,\n    \"values\": [\n      {\n        \"value\": \"7\"\n      }\n    ],\n    \"_name\": \"屏幕最大尺寸，英寸\",\n    \"_source\": \"Макс. диагональ, дюймы\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 7199,\n    \"values\": [\n      {\n        \"value\": \"ABS塑料\",\n        \"dictionary_value_id\": 61704\n      },\n      {\n        \"value\": \"硅胶\",\n        \"dictionary_value_id\": 62077\n      }\n    ],\n    \"_name\": \"材料\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 20410,\n    \"values\": [\n      {\n        \"value\": \"360度旋转\",\n        \"dictionary_value_id\": 971053322\n      },\n      {\n        \"value\": \"适用于智能手机\",\n        \"dictionary_value_id\": 971053325\n      }\n    ],\n    \"_name\": \"持有人特征\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8416,\n    \"values\": [\n      {\n        \"value\": \"12\"\n      }\n    ],\n    \"_name\": \"宽度，厘米\",\n    \"_source\": \"Ширина, см\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Автомобильный держатель YCAR предназначен для размещения смартфона в машине. Гравитационная конструкция подходит для смартфонов с диагональю до 7 дюймов. Крепление на присоске можно установить на лобовое стекло или приборную панель. Держатель выполнен из ABS-пластика и силикона, оснащен поворотным механизмом на 360 градусов и регулируемой длинной конструкцией. Подойдет для использования навигации, звонков и прослушивания музыки в поездке. Беспроводная зарядка не предусмотрена.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 11650,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"原厂包装数量\",\n    \"_source\": \"系统默认：原厂包装数量 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10400,\n    \"values\": [\n      {\n        \"value\": \"1 年\",\n        \"dictionary_value_id\": 970716397\n      }\n    ],\n    \"_name\": \"保证\",\n    \"_source\": \"系统默认：保证 1 年（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4383,\n    \"values\": [\n      {\n        \"value\": \"211.0\"\n      }\n    ],\n    \"_name\": \"商品重量，克\",\n    \"_source\": \"自动工作台：商品净重\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8415,\n    \"values\": [\n      {\n        \"value\": \"24\"\n      }\n    ],\n    \"_name\": \"长度，厘米\",\n    \"_source\": \"Длина, см\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 23171,\n    \"values\": [\n      {\n        \"value\": \"#автомобильный_держатель #держатель_телефона_в_машину #автодержатель_для_смартфона #крепление_для_телефона_в_авто #держатель_смартфона #держатель_телефона_на_стекло #держатель_телефона_на_панель #держатель_на_лобовое_стекло #держатель_на_приборную_панель #гравитационный_держатель #подставка_для_телефона #крепление_смартфона #автомобильная_подставка #держатель_для_навигатора #держатель_телефона #поворотный_автодержатель #регулируемый_держатель #держатель_для_телефона #автоаксессуар_для_смартфона #крепление_телефона_на_торпеду #держатель_для_ежедневных #черный_держатель_для_телефона #держатель_для_смартфона_до_7 #держатель_из_abs_пластика #силиконовый_держатель\"\n      }\n    ],\n    \"_name\": \"#主题标签\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4180,\n    \"values\": [\n      {\n        \"value\": \"Автомобильный держатель для телефона YCAR на присо