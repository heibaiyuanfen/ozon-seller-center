        "attributes_json": "[\n  {\n    \"complex_id\": 0,\n    \"id\": 7956,\n    \"values\": [\n      {\n        \"value\": \"8.3\"\n      }\n    ],\n    \"_name\": \"长度，厘米\",\n    \"_source\": \"Длина, см\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Кистевой эспандер в форме кольца для тренировки кистей, рук и предплечий. Подходит для развития силы хвата, упражнений на мелкую моторику и расслабления мышц после нагрузки. Изготовлен из силикона, имеет водонепроницаемые свойства и изменяемую нагрузку до 25 кг. Подходит взрослым и детям для домашних тренировок, занятий в зале, ЛФК и спортивной подготовки. В комплекте 1 эспандер бирюзового цвета.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 11650,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"原厂包装数量\",\n    \"_source\": \"系统默认：原厂包装数量 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4389,\n    \"values\": [\n      {\n        \"value\": \"中国\",\n        \"dictionary_value_id\": 90296\n      }\n    ],\n    \"_name\": \"原产国\",\n    \"_source\": \"系统默认：原产国 中国（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 85,\n    \"values\": [\n      {\n        \"value\": \"Нет бренда\",\n        \"dictionary_value_id\": 126745801\n      }\n    ],\n    \"_name\": \"品牌\",\n    \"_source\": \"系统锁定：无品牌\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10400,\n    \"values\": [\n      {\n        \"value\": \"1 年\",\n        \"dictionary_value_id\": 970716397\n      }\n    ],\n    \"_name\": \"保证\",\n    \"_source\": \"系统默认：保证 1 年（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 23171,\n    \"values\": [\n      {\n        \"value\": \"#эспандер_кистевой #эспандер_для_рук #эспандер_для_кисти #кистевой_тренажер #тренажер_для_кистей #тренажер_для_рук #кольцевой_эспандер #резиновый_эспандер #силиконовый_эспандер #ручной_эспандер #тренажер_для_хв