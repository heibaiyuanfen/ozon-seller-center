        "attribute_definitions": [
          {
            "id": 10400,
            "attribute_complex_id": 0,
            "name": "保证",
            "description": "制造商对产品质量负责的期间。 并且买方可以申请保修案件的退款。 从下拉列表中选择一个值。",
            "type": "String",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "基本信息",
            "group_id": 1,
            "dictionary_id": 46700526,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Гарантия",
            "description_ru": "Период, в течение которого производитель отвечает за качество товара. А покупатель может оформить заявку на возврат по гарантийному случаю. Выберите одно значение из выпадающего списка.",
            "group_name_ru": "Общие"
          },
          {
            "id": 6326,
            "attribute_complex_id": 0,
            "name": "固定装置的特点",
            "description": "请从列表中选择或手动输入。您可以添加多个值，并以分号（；）来分隔。如果属性值中包含分号，那么请将该符号置于双引号中（如“；”）。",
            "type": "String",
            "is_collection": true,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "技术参数",
            "group_id": 108,
            "dictionary_id": 120,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Особенности светильников",
            "description_ru": "Выберите из списка или укажите вручную. Можно добавить несколько значений через точку с запятой. Если точка с запятой есть в значении атрибута, поместите знак в кавычки \";\".",
            "group_name_ru": "Технические свойства"
          },
          {
            "id": 11254,
            "attribute_complex_id": 0,
            "name": "JSON富内容",
            "description": "使用JSON格式的模板添加带有照片和视频的扩展产品描述。 有关填写此特征的详细信息，请参阅知识库中的文章\"丰富内容\"。",
            "type": "String",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 0,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Rich-контент JSON",
            "description_ru": "Добавьте расширенное описание товара с фото и видео по шаблону в формате JSON. Подробнее о заполнении этой характеристики можно узнать в статье \"Rich-контент\" в \"Базе знаний\".",
            "group_name_ru": ""
          },
          {
            "id": 8229,
            "attribute_complex_id": 0,
            "name": "类型",
            "description": "从列表中选择最合适的产品类型。 这些类型参与了Ozon网站上的产品分类。 要正确指定类型，请在Ozon网站上找到与您相似的产品，并在此字段中指定相同的类型。",
            "type": "String",
            "is_collection": false,
            "is_required": true,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 1960,
            "category_dependent": true,
            "complex_is_collection": false,
            "name_ru": "Тип",
            "description_ru": "Выберите из списка наиболее подходящий тип товара. Типы участвуют в распределении товаров по категориям на сайте Ozon. Чтобы правильно указать тип, найдите на сайте Ozon товары, похожие на ваш, и укажите в этом поле такой же тип.",
            "group_name_ru": ""
          },
          {
