        "attributes_json": "[\n  {\n    \"complex_id\": 0,\n    \"id\": 4383,\n    \"values\": [\n      {\n        \"value\": \"1100\"\n      }\n    ],\n    \"_name\": \"商品重量，克\",\n    \"_source\": \"自动工作台：商品净重\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9048,\n    \"values\": [\n      {\n        \"value\": \"AUTO-20260818-20AA99\"\n      }\n    ],\n    \"_name\": \"型号名称（针对合并为一张商品卡片）\",\n    \"_source\": \"人工填写：型号名称（合并多变体）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4066,\n    \"values\": [\n      {\n        \"value\": \"300\"\n      }\n    ],\n    \"_name\": \"宽度，厘米\",\n    \"_source\": \"Ширина, см\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10097,\n    \"values\": [\n      {\n        \"value\": \"зелёный\"\n      }\n    ],\n    \"_name\": \"颜色名称\",\n    \"_source\": \"AI映射页面事实：В характеристиках указан зелёный цвет.\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 23171,\n    \"values\": [\n      {\n        \"value\": \"#маскировочная_сеть #камуфляжная_сеть #затеняющая_сеть #маскировочная_сетка #сетка_для_маскировки #сеть_для_охоты #сетка_для_охоты #маскировка_для_охоты #сеть_для_страйкбола #сетка_для_страйкбола #сетка_для_тактических_игр #укрытие_для_охоты #маскировка_в_лесу #маскировка_на_природе #сетка_от_солнца #навес_от_солнца #сетка_для_навеса #сетка_для_беседки #сетка_для_зоны_отдыха #сетка_для_сада #сетка_для_забора #декор_для_забора #декор_фасада #сетка_для_фасада #маскировка_техники #маскировка_оборудования #сетка_с_креплениями #сетка_с_ремнями #двухслойная_сеть #небликующая_сетка\"\n      }\n    ],\n    \"_name\": \"#主题标签\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Зелёная маскировочная сеть размером 3×6 м в растянутом виде. Подходит для охоты, страйкбола и тактических игр, а также для создания тени над беседкой, зоной отдыха, техникой или оборудованием. Может использоваться для декора фасадов, заборов и садовых конструкций. Сетка имеет двухслойную конструкцию, прошитые края по периметру, точки крепления в центре через каждые 2 м и крепёжные ремни на четырёх углах. Не шуршит, не бликует и не впитывает влагу. Уровень затенения — 60–80%. Рассчитана на температуру до +40 °C. Фактический размер в растянутом состоянии может отличаться на 10–50 см. При длительном воздействии яркого солнца возможно незначительное выцветание.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 11650,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"原厂包装数量\",\n    \"_source\": \"系统默认：原厂包装数量 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8229,\n    \"values\": [\n      {\n        \"value\": \"狩猎伪装\",\n        \"dictionary_value_id\": 970827604\n      }\n    ],\n    \"_name\": \"类型\",\n    \"_source\": \"Тип + Ozon字典精确匹配\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4389,\n    \"values\": [\n      {\n        \"value\": \"中国\",\n        \"dictionary_value_id\": 90296\n      }\n    ],\n    \"_name\": \"原产国\",\n    \"_source\": \"系统默认：原产国 中国（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4180,\n    \"values\": [\n      {\n        \"value\": \"Маскировочная затеняющая сеть 3×6 м\"\n      }\n    ],\n    \"_name\": \"名称\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 85,\n    \"values\": [\n      {\n        \"value\": \"Нет бренда\",\n        \"dictionary_value_id\": 126745801\n      }\n    ],\n    \"_name\": \"品牌\",\n    \"_source\": \"系统锁定：无品牌\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10096,\n    \"values\": [\n      {\n        \"value\": \"绿色\",\n        \"dictionary_value_id\": 61583\n      }\n    ],\n    \"_name\": \"商品颜色\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9814,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"数量，件\",\n    \"_source\": \"Количество, шт\"\n  },\n  {\n    \"compl