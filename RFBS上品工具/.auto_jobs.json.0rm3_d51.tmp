        "attribute_definitions": [
          {
            "id": 9048,
            "attribute_complex_id": 0,
            "name": "型号名称（针对合并为一张商品卡片）",
            "description": "在该字段中填写要合并的产品的任何相同值。 并以不同的方式，如果货物需要分开。 如果产品具有相同的类型和品牌，并且在组合中的所有产品上不同地填充至少一个可变特征，则将发生组合。",
            "type": "String",
            "is_collection": false,
            "is_required": true,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 0,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Название модели (для объединения в одну карточку)",
            "description_ru": "Заполните данное поле любым одинаковым значением на товарах, которые хотите объединить. И по разному, если товары нужно разъединить. Объединение произойдет при условии, что товары имеют одинаковый Тип и Бренд, и хотя бы одна вариативная характеристика заполнена по разному на всех товарах в объединении",
            "group_name_ru": ""
          },
          {
            "id": 4082,
            "attribute_complex_id": 0,
            "name": "包装尺寸（长X宽x高），厘米",
            "description": "包装中产品侧面的尺寸以厘米为单位。 填充格式：LxWxH，其中L为长度，W为宽度，H为高度。 没有计量单位。 例如：7x6x1.5。",
            "type": "String",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 0,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Размер упаковки (Длина х Ширина х Высота), см",
            "description_ru": "Размеры сторон товара в упаковке в сантиметрах. Формат заполнения: ДхШхВ, где Д - длина, Ш - ширина, В - высота. Без единиц измерения. Пример: 7х6х1.5.",
            "group_name_ru": ""
          },
          {
            "id": 11254,
            "attribute_complex_id": 0,
            "name": "JSON富内容",
            "description": "使用JSON格式的模板添加带有照片和视频的扩展产品描述。 有关填写此特征的详细信息，请参阅知识库中的文章\"丰富内容\"。",
            "type": "String",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 0,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Rich-контент JSON",
            "description_ru": "Добавьте расширенное описание товара с фото и видео по шаблону в формате JSON. Подробнее о заполнении этой характеристики можно узнать в статье \"Rich-контент\" в \"Базе знаний\".",
            "group_name_ru": ""
          },
          {
            "id": 23249,
            "attribute_complex_id": 0,
            "name": "统一计量单位中的商品数量",
            "description": "UEI是一个统一的计量单位。 必须根据当地立法规定在白俄罗斯共和国领土上销售货物。 表示每个SKU的件数。 您只能指定一个整数。",
            "type": "Decimal",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 0,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Количество товара в УЕИ",
            "description_ru": "УЕИ – унифицированная единица измерения. Необходимо указывать для продажи товаров на территории Республики Беларусь согласно локальному законодательству. Указывается количество ШТУК в одной SKU. Можно указать только целое число.",
            "group_name_ru": ""
          },
          {
            "id": 10400,
            "attribute_complex_id": 0,
            "name": "保证",
            "description": "制造商对产品质量负责的期间。 并且买方可以申请保修案件的退款。 从下拉列表中选择一个值。",
            "type": "String",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 46700526,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Гарантия",
            "description_ru": "Период, в течение которого производитель отвечает за качество товара. А покупатель может оформить заявку на возврат по гарантийному случаю. Выберите одно значение из выпадающего списка.",
            "group_name_ru": ""
          },
          {
            "id": 8790,
            "attribute_complex_id": 8788,
            "name": "PDF 文件",
            "description": "",
            "type": "URL",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 0,
            "category_dependent": false,
            "complex_is_collection": true,
            "name_ru": "Документ PDF",
            "description_ru": "",
            "group_name_ru": ""
          },
          {
            "id": 4958,
            "attribute_complex_id": 0,
            "name": "专为",
            "description": "Выберите одно или несколько значений из списка, но не больше 3. В xls-файле варианты заполняются через точку с запятой (;) без пробелов.",
            "type": "String",
            "is_collection": true,
            "is_required": true,
            "is_aspect": false,
            "max_value_count": 3,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 749,
            "category_dependent": true,
            "complex_is_collection": false,
            "name_ru": "Предназначено для",
            "description_ru": "Выберите одно или несколько значений из списка, но не больше 3. В xls-файле варианты заполняются через точку с запятой (;) без пробелов.",
            "group_name_ru": ""
          },
          {
            "id": 8229,
            "attribute_complex_id": 0,
            "name": "类型",
            "description": "从列表中选择最合适的产品类型。 这些类型参与了Ozon网站上的产品分类。 要正确指定类型，请在Ozon网站上找到与您相似的产品，并在此字段中指定相同的类型。",
            "type": "String",
            "is_collection": false,
            "is_required": true,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 1960,
            "category_dependent": true,
            "complex_is_collection": false,
            "name_ru": "Тип",
            "description_ru": "Выберите из списка наиболее подходящий тип товара. Типы участвуют в распределении товаров по категориям на сайте Ozon. Чтобы правильно указать тип, найдите на сайте Ozon товары, похожие на ваш, и укажите в этом поле такой же тип.",
            "group_name_ru": ""
          },
          {
            "id": 21845,
            "attribute_complex_id": 100002,
            "name": "臭氧。视频背景：链接",
            "description": "指定视频（MP4，MOV）的链接。 持续时间从8到30秒，文件大小不超过20MB",
            "type": "String",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 0,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Озон.Видеообложка: ссылка",
            "description_ru": "Укажите ссылку на видео (MP4, MOV). Продолжительность от 8 до 30 секунд, размер файла не более 20МБ",
            "group_name_ru": ""
          },
          {
            "id": 4180,
            "attribute_complex_id": 0,
            "name": "名称",
            "description": "名称是按照原则写的：类型+品牌+型号（系列+解释）+制造商的文章+，（逗号）+名称属性不是用大写字母写的（我们不使用caps lock）。 在属性之前放置逗号。 如果有几个属性，它们也用逗号分隔。 如果名称中没有任何部分，请跳过它。 属性可以是：颜色，重量，体积，包装中的件数等。 颜色是用一个小字母写成的，用阳刚的，单数的。 我们不把颜色这个词写在名字里。 最后没有点。 除逗号外，我们不使用任何标点符号。 我们只在俄语中使用引号. 正确名称的例子：Apple iPhone XS MT572RU/a智能手机，space black Dr.Martens经典运动鞋，白色和黑色，尺寸43Ariel Magic white洗涤剂带量勺，15公斤Heinz Xtreme Tabasco超快酱，10毫升动物玩具四爪\"跑鼠\"BMM，白",
            "type": "String",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 0,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Название",
            "description_ru": "Название пишется по принципу: Тип + Бренд + Модель (серия + пояснение) + Артикул производителя + , (запятая) + Атрибут Название не пишется большими буквами (не используем caps lock). Перед атрибутом ставится запятая. Если атрибутов несколько, они так же разделяются запятыми. Если какой-то составной части названия нет - пропускаем её. Атрибутом может быть: цвет, вес, объём, количество штук в упаковке и т.д. Цвет пишется с маленькой буквы, в мужском роде, единственном числе. Слово цвет в названии не пишем. Точка в конце не ставится. Никаких знаков препинания, кроме запятой, не используем. Кавычки используем только для названий на русском языке. Примеры корректных названий: Смартфон Apple iPhone XS MT572RU/A, space black Кеды Dr. Martens Киноклассика, бело-черные, размер 43 Стиральный порошок Ariel Магия белого с мерной ложкой, 15 кг Соус Heinz Xtreme Tabasco суперострый, 10 мл Игрушка для животных Четыре лапы \"Бегающая мышка\" БММ, белый",
            "group_name_ru": ""
          },
          {
            "id": 4384,
            "attribute_complex_id": 0,
            "name": "配套",
            "description": "列出产品中包含的内容：说明，案例，一套电线等。 不要复制其他特征（包中的注释、类型或数量）的值。 如果您正在交付没有额外包裹的物品，请不要填写此说明。 ",
            "type": "String",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 0,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Комплектация",
            "description_ru": "Перечислите, что входит в комплект вместе с товаром: инструкция, чехол, комплект проводов и т.п. Не дублируйте сюда значения других характеристик (аннотацию, тип или количество в упаковке). Если вы поставляете товар без дополнительной комплектации, не заполняйте эту характеристику. ",
            "group_name_ru": ""
          },
          {
            "id": 11650,
            "attribute_complex_id": 0,
            "name": "原厂包装数量",
            "description": "你在这个SKU下销售多少个工厂包？ 示例：24罐婴儿泥在工厂密封在1包装中，并在其他商店以相同的形式出售—指定值1。\n另一个例子：工厂以1或10件的包装生产灯泡，您决定出售3个灯泡并将其密封在一个包装中—属性值将为3",
            "type": "Integer",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 0,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Количество заводских упаковок",
            "description_ru": "Сколько заводских упаковок продаёте под этим SKU. Пример: 24 банки детского пюре запаяны в 1 упаковку на заводе и в таком же виде продаются в других магазинах — укажите значение 1. \nДругой пример: завод выпускает лампочки в упаковках по 1 или 10 штук, а вы решили продавать по 3 лампочки и запаяли их в одну упаковку — значение атрибута будет 3",
            "group_name_ru": ""
          },
          {
            "id": 4386,
            "attribute_complex_id": 0,
            "name": "包装",
            "description": "Выберите одно или несколько значений из выпадающего списка, но не более 3-х. В xls-файле варианты заполняются через точку с запятой (;) без пробелов.",
            "type": "String",
            "is_collection": true,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 3,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 1880,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Упаковка",
            "description_ru": "Выберите одно или несколько значений из выпадающего списка, но не более 3-х. В xls-файле варианты заполняются через точку с запятой (;) без пробелов.",
            "group_name_ru": ""
          },
          {
            "id": 21837,
            "attribute_complex_id": 100001,
            "name": "臭氧。视频：标题",
            "description": "为视频指定名称",
            "type": "String",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 0,
            "category_dependent": false,
            "complex_is_collection": true,
            "name_ru": "Озон.Видео: название",
            "description_ru": "Укажите название для видео",
            "group_name_ru": ""
          },
          {
            "id": 5379,
            "attribute_complex_id": 0,
            "name": "保质期（天）",
            "description": "制造商设定的到期日期。 根据报价，交付到FBO仓库的货物的总保质期不应少于120天，因此货物可能不被接受fbo交付。 臭氧履行中心和臭氧新鲜黑暗商店的有效期规则可能会有所不同。 从臭氧仓库销售的规定可以在\"知识库\"中找到。",
            "type": "Integer",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 0,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Срок годности в днях",
            "description_ru": "Срок годности, установленный производителем. Согласно оферте, общий срок годности поставляемого товара на склад FBO не должен быть менее 120 дней, в связи с чем товары могут быть не приняты при поставках по FBO. Правила по срокам годности для фулфилмент-центров Ozon и дарксторов Ozon fresh могут различаться. С регламентами по продаже со склада Ozon можно ознакомиться в \"Базе знаний\".",
            "group_name_ru": ""
          },
          {
            "id": 4967,
            "attribute_complex_id": 0,
            "name": "材料",
