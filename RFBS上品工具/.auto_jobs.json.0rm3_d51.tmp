        "attributes_json": "[\n  {\n    \"complex_id\": 0,\n    \"id\": 9048,\n    \"values\": [\n      {\n        \"value\": \"AUTO-20260914-E0C45D\"\n      }\n    ],\n    \"_name\": \"型号名称（针对合并为一张商品卡片）\",\n    \"_source\": \"人工填写：型号名称（合并多变体）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4386,\n    \"values\": [\n      {\n        \"value\": \"Bag-in-Box\",\n        \"dictionary_value_id\": 971412335\n      }\n    ],\n    \"_name\": \"包装\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4180,\n    \"values\": [\n      {\n        \"value\": \"Уличный солнечный светильник на зажиме с датчиком движения\"\n      }\n    ],\n    \"_name\": \"名称\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9802,\n    \"values\": [\n      {\n        \"value\": \"120\"\n      }\n    ],\n    \"_name\": \"长度，毫米\",\n    \"_source\": \"Длина, мм\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8414,\n    \"values\": [\n      {\n        \"value\": \"5\"\n      }\n    ],\n    \"_name\": \"高度，厘米\",\n    \"_source\": \"Высота, см\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 11650,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"原厂包装数量\",\n    \"_source\": \"系统默认：原厂包装数量 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8383,\n    \"values\": [\n      {\n        \"value\": \"90\"\n      }\n    ],\n    \"_name\": \"光通量，Lm\",\n    \"_source\": \"AI映射页面事实：Площадь освещения — 90 кв. м.\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4383,\n    \"values\": [\n      {\n        \"value\": \"230\"\n      }\n    ],\n    \"_name\": \"商品重量，克\",\n    \"_source\": \"自动工作台：商品净重\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6322,\n    \"values\": [\n      {\n        \"value\": \"90\"\n      }\n    ],\n    \"_name\": \"照明面积，平方米\",\n    \"_source\": \"Площадь освещения, кв.м\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10096,\n    \"values\": [\n      {\n        \"value\": \"黑色\",\n        \"dictionary_value_id\": 61574\n      }\n    ],\n    \"_name\": \"商品颜色\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6605,\n    \"values\": [\n      {\n        \"value\": \"80\"\n      }\n    ],\n    \"_name\": \"宽度，毫米\",\n    \"_source\": \"Ширина, мм\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 85,\n    \"values\": [\n      {\n        \"value\": \"Нет бренда\",\n        \"dictionary_value_id\": 126745801\n      }\n    ],\n    \"_name\": \"品牌\",\n    \"_source\": \"系统锁定：无品牌\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6318,\n    \"values\": [\n      {\n        \"value\": \"28\"\n      }\n    ],\n    \"_name\": \"灯管数量，个\",\n    \"_source\": \"Количество ламп, шт\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10400,\n    \"values\": [\n      {\n        \"value\": \"1 年\",\n        \"dictionary_value_id\": 970716397\n      }\n    ],\n    \"_name\": \"保证\",\n    \"_source\": \"系统默认：保证 1 年（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4384,\n    \"values\": [\n      {\n        \"value\": \"светильник с крепежным зажимом и инструкция на русском языке\"\n      }\n    ],\n    \"_name\": \"配套\",\n    \"_source\": \"AI映射页面事实：Описание прямо указывает комплект поставки.\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8962,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"一个商品中的件数\",\n    \"_source\": \"系统默认：一个商品中的件数 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 5269,\n    \"values\": [\n      {\n        \"value\": \"IP65\",\n        \"dictionary_value_id\": 83671\n      }\n    ],\n    \"_name\": \"防护等级\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Солнечный уличный светильник с креплением-струбциной подходит для забора, ворот, перил, балконных ограждений, ветвей деревьев и других элементов участка. Для установки не требуется сверление: зажим фиксирует светильник на металлических и деревянных прутьях. Модель оснащена 28 светодиодными лампами, датчиком движения и солнечной батареей, поэтому подключение к центральной электросети не нужно. При обнаружении движения людей или животных светильник автоматически включается на максимальную яркость. Доступны три режима работы: постоянное слабое свечение, включение по датчику движения и ручная регулировка яркости. Корпус защищён от пыли и влаги по стандарту IP65, подходит для использования на улице в дождь, снег и при перепадах температур. Светильник помогает осветить вход в дом, двор, проходы вдоль забора и садовые дорожки. Угол освещения регулируется на 360°. Площадь освещения — до 90 м², максимальная мощность ламп — 9 Вт. Размеры: высота 5 см, ширина 80 мм, длина 120 мм. Цвет — чёрный. В комплект входят светильник с крепёжным зажимом и инструкция на русском языке.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8386,\n    \"values\": [\n      {\n        \"value\": \"солнечный свет\"\n      }\n    ],\n    \"_name\": \"光照温度，K\",\n    \"_source\": \"AI映射页面事实：В описании указана яркая равномерная подсветка, но температура света не приведена.\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4389,\n    \"values\": [\n      {\n        \"value\": \"中国\",\n        \"dictionary_value_id\": 90296\n      }\n    ],\n    \"_name\": \"原产国\",\n    \"_source\": \"系统默认：原产国 中国（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6319,\n    \"values\": [\n      {\n        \"value\": \"9\"\n      }\n    ],\n    \"_name\": \"麦克斯。灯功率，W\",\n    \"_source\": \"Макс. мощность ламп, Вт\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 23171,\n    \"values\": [\n      {\n        \"value\": \"#уличный_светильник #солнечный_уличный_светильник #уличный_фонарь_солнечный #фонарь_на_солнечной_батарее #светильник_на_зажиме #уличный_светильник_на_зажиме #светильник_с_датчиком #солнечный_светильник_датчик #светодиодный_фонарь #солнечный_фонарь_для_забора #светильник_для_забора #фонарь_для_забора #светильник_для_дачи #фонарь_для_дачи #освещение_участка #светильник_для_двора #фонарь_для_двора #светильник_для_ворот #светильник_для_балкона #светильник_для_беседки #фонарь_для_сада #освещение_периметра #беспроводной_светильник #садовое_освещение #наружный_светильник #фонарь_с_датчиком_движения #солнечный_фонарь_для_дачи #светильник_без_сети #освещение_дорожек\"\n      }\n    ],\n    \"_name\": \"#主题标签\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6320,\n    \"values\": [\n      {\n        \"value\": \"ABS塑料\",\n        \"dictionary_value_id\": 61704\n      }\n    ],\n    \"_name\": \"灯罩材料\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 5788,\n    \"values\": [\n      {\n        \"value\": \"防尘和防潮\",\n        \"dictionary_value_id\": 970668337\n      }\n    ],\n    \"_name\": \"保护、房屋的特点\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6326,\n    \"values\": [\n      {\n        \"value\": \"适用于高天花板\",\n        \"dictionary_value_id\": 971116648\n      }\n    ],\n    \"_name\": \"固定装置的特点\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6317,\n    \"values\": [\n      {\n        \"value\": \"发光二极管\",\n        \"dictionary_value_id\": 1896\n      }\n    ],\n    \"_name\": \"灯的类型\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 12138,\n    \"values\": [\n      {\n        \"value\": \"是的\",\n        \"dictionary_value_id\": 970701879\n      }\n    ],\n    \"_name\": \"全套灯泡\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 5480,\n    \"values\": [\n      {\n        \"value\": \"钳\",\n        \"dictionary_value_id\": 1874\n      }\n    ],\n    \"_name\": \"支架\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8229,\n    \"values\