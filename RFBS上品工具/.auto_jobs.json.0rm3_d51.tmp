ues\": [\n      {\n        \"value\": \"610\"\n      }\n    ],\n    \"_name\": \"商品重量，克\",\n    \"_source\": \"自动工作台：商品净重\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9048,\n    \"values\": [\n      {\n        \"value\": \"AUTO-20260812-E9E8B3\"\n      }\n    ],\n    \"_name\": \"型号名称（针对合并为一张商品卡片）\",\n    \"_source\": \"人工填写：型号名称（合并多变体）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4067,\n    \"values\": [\n      {\n        \"value\": \"25х25\"\n      }\n    ],\n    \"_name\": \"尺寸，厘米\",\n    \"_source\": \"Размер, см\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10400,\n    \"values\": [\n      {\n        \"value\": \"1 年\",\n        \"dictionary_value_id\": 970716397\n      }\n    ],\n    \"_name\": \"保证\",\n    \"_source\": \"系统默认：保证 1 年（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 7359,\n    \"values\": [\n      {\n        \"value\": \"抗菌\",\n        \"dictionary_value_id\": 75130\n      },\n      {\n        \"value\": \"穿孔\",\n        \"dictionary_value_id\": 75139\n      },\n      {\n        \"value\": \"抗静电作用\",\n        \"dictionary_value_id\": 75131\n      },\n      {\n        \"value\": \"吸收\",\n        \"dictionary_value_id\": 75133\n      },\n      {\n        \"value\": \"静电效应\",\n        \"dictionary_value_id\": 75146\n      }\n    ],\n    \"_name\": \"清洁设备的特点\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 11650,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"原厂包装数量\",\n    \"_source\": \"系统默认：原厂包装数量 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Отрывные многоразовые салфетки из микрофибры для уборки кухни, ванной комнаты, дома и автомобиля. В рулоне 50 серых салфеток размером 25×25 см и плотностью 200 г/м². Материал впитывает воду, помогает удалять пыль, грязь, пятна и жир, не оставляет ворса и разводов. Салфетки можно использовать сухими или влажными, с моющим средством или без него. Подходят для стекол, зеркал, мебели, посуды, плитки, сантехники, бытовой техники, оргтехники, экранов и салона автомобиля. Салфетки обладают антистатическим и антибактериальным эффектом, не сохраняют запахи и не царапают поверхности.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4180,\n    \"values\": [\n      {\n        \"value\": \"Салфетки для уборки из микрофибры в рулоне, 50 шт., 25×25 см\"\n      }\n    ],\n    \"_name\": \"名称\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6456,\n    \"values\": [\n      {\n        \"value\": \"适用于汽车\",\n        \"dictionary_value_id\": 81846\n      },\n      {\n        \"value\": \"适用于瓷砖和瓷砖\",\n        \"dictionary_value_id\": 81849\n      },\n      {\n        \"value\": \"用于家具\",\n        \"dictionary_value_id\": 81851\n      },\n      {\n        \"value\": \"用于厨具\",\n        \"dictionary_value_id\": 81857\n      },\n      {\n        \"value\": \"用于扫除灰尘\",\n        \"dictionary_value_id\": 81858\n      },\n      {\n        \"value\": \"适用于浴室\",\n        \"dictionary_value_id\": 81866\n      },\n      {\n        \"value\": \"适用于玻璃和镜子\",\n        \"dictionary_value_id\": 970965251\n      }\n    ],\n    \"_name\": \"用途\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6383,\n    \"values\": [\n      {\n        \"value\": \"超纤\",\n        \"dictionary_value_id\": 61949\n      }\n    ],\n    \"_name\": \"材料\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8229,\n    \"values\": [\n      {\n        \"value\": \"清洁抹布\",\n        \"dictionary_value_id\": 96018\n      }\n    ],\n    \"_name\": \"类型\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  }\n]",
