        "attribute_definitions": [
          {
            "id": 22270,
            "attribute_complex_id": 0,
            "name": "产品发布类型",
            "description": "如果您选择\"手工制作\"，则意味着该产品是知识产权的一部分，并且在不使用专门设备的情况下制造。 如果您选择\"定制设计\"，这意味着产品是在客户下订单并提出个人要求后才制作的，例如，雕刻的照片或文字。",
            "type": "String",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 124412424,
            "category_dependent": true,
            "complex_is_collection": false,
            "name_ru": "Вид выпуска товара",
            "description_ru": "Если вы выбираете \"Ручная работа\", то это означает, что товар является частью интеллектуальной собственности и изготовлен без использования специализированного оборудования. Если вы выбираете \"По индивидуальному дизайну\", то это означает, что товар изготавливается только после сделанного покупателем заказа с предоставления личных запросов, например, фото или текста для гравировки.",
            "group_name_ru": ""
          },
          {
            "id": 6320,
            "attribute_complex_id": 0,
            "name": "灯罩材料",
            "description": "请从列表中选择或手动输入。您可以添加多个值，并以分号（；）来分隔。如果属性值中包含分号，那么请将该符号置于双引号中（如“；”）。",
            "type": "String",
            "is_collection": true,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "技术参数",
            "group_id": 108,
            "dictionary_id": 1503,
            "category_dependent": true,
            "complex_is_collection": false,
            "name_ru": "Материал плафона",
            "description_ru": "Выберите из списка или укажите вручную. Можно добавить несколько значений через точку с запятой. Если точка с запятой есть в значении атрибута, поместите знак в кавычки \";\".",
            "group_name_ru": "Технические свойства"
          },
          {
            "id": 8962,
            "attribute_complex_id": 0,
            "name": "一个商品中的件数",
            "description": "将以指定价格出售给客户的产品单位数。 例如，一包6瓶水或一包12瓶食物。 如果单独销售产品，请在此字段中指定1。 您只能指定一个整数。",
            "type": "Integer",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
            "group_id": 0,
            "dictionary_id": 0,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Единиц в одном товаре",
            "description_ru": "Количество единиц товара, которое будет продано клиенту за указанную цену. Например, 6 бутылок воды в одной упаковке или 12 паучей корма в одной упаковке. Если продаете товар поштучно, укажите в этом поле 1. Можно указать только целое число.",
            "group_name_ru": ""
          },
          {
            "id": 6315,
            "attribute_complex_id": 0,
            "name": "底座类型",
            "description": "请从列表中选择或手动输入。您可以添加多个值，并以分号（；）来分隔。如果属性值中包含分号，那么请将该符号置于双引号中（如“；”）。",
            "type": "String",
            "is_collection": true,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "技术参数",
