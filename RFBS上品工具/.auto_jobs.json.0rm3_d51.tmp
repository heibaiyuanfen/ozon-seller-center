        "attributes_json": "[\n  {\n    \"complex_id\": 0,\n    \"id\": 85,\n    \"values\": [\n      {\n        \"value\": \"Нет бренда\",\n        \"dictionary_value_id\": 126745801\n      }\n    ],\n    \"_name\": \"品牌\",\n    \"_source\": \"系统锁定：无品牌\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8962,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"一个商品中的件数\",\n    \"_source\": \"系统默认：一个商品中的件数 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4389,\n    \"values\": [\n      {\n        \"value\": \"中国\",\n        \"dictionary_value_id\": 90296\n      }\n    ],\n    \"_name\": \"原产国\",\n    \"_source\": \"系统默认：原产国 中国（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4383,\n    \"values\": [\n      {\n        \"value\": \"136.0\"\n      }\n    ],\n    \"_name\": \"商品重量，克\",\n    \"_source\": \"自动工作台：商品净重\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Уличный настенный светильник на солнечной энергии для автономного освещения сада, двора, входной зоны или участка. 100 LED обеспечивают яркий режим при обнаружении движения, а при его отсутствии светильник переходит в энергосберегающий режим. Встроенный фотодатчик автоматически включает освещение с наступлением темноты и выключает его на рассвете. Питание осуществляется от солнечной панели из монокристаллического кремния и перезаряжаемой литиевой батареи — прокладка проводов не требуется. Корпус из ABS-пластика имеет степень защиты IP65 от пыли и сильных струй воды. Светильник подходит для наружной установки и рассчитан на воздействие дождя, снега, УФ-излучения и мороза.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10400,\n    \"values\": [\n      {\n        \"value\": \"1 年\",\n        \"dictionary_value_id\": 970716397\n      }\n    ],\n    \"_name\": \"保证\",\n    \"_source\": \"系统默认：保证 1 年（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 12141,\n    \"values\": [\n      {\n        \"value\": \"100 светодиодов\"\n      }\n    ],\n    \"_name\": \"名称模板的模型名称\",\n    \"_source\": \"AI映射页面事实：В названии указан светильник 100LED.\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 23171,\n    \"values\": [\n      {\n        \"value\": \"#светильник_солнечный #уличный_солнечный_светильник #садовый_светильник #настенный_уличный_светильник #уличный_прожектор #садовый_прожектор #прожектор_с_датчиком #светильник_датчик_движения #светильник_солнечная_батарея #светильник_без_проводов #автономный_светильник #светильник_для_дачи #светильник_для_сада #светильник_для_двора #светильник_для_крыльца #светильник_для_гаража #подсветка_участка #освещение_участка #подсветка_входа #подсветка_фасада #подсветка_дорожки #уличное_освещение #садовое_освещение #светильник_с_фотодатчиком #светильник_солнечная_панель #светильник_из_абс_пластика #светодиодный_прожектор #светодиодный_светильник #наружный_светильник #освещение_без_проводов\"\n      }\n    ],\n    \"_name\": \"#主题标签\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10096,\n    \"values\": [\n      {\n        \"value\": \"黑色\",\n        \"dictionary_value_id\": 61574\n      }\n    ],\n    \"_name\": \"商品颜色\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 5269,\n    \"values\": [\n      {\n        \"value\": \"IP65\",\n        \"dictionary_value_id\": 83671\n      }\n    ],\n    \"_name\": \"防护等级\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 11650,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"原厂包装数量\",\n    \"_source\": \"系统默认：原厂包装数量 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4180,\n    \"values\": [\n      {\n        \"value\": \"Солнечный уличный светильник 100 LED с датчиком движения, IP65\"\n      }\n    ],\n    \"_name\": \"名称\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id