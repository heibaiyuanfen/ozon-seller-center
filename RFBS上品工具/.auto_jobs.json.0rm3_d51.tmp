            "complex_is_collection": false,
            "name_ru": "Озон.Видеообложка: ссылка",
            "description_ru": "Укажите ссылку на видео (MP4, MOV). Продолжительность от 8 до 30 секунд, размер файла не более 20МБ",
            "group_name_ru": ""
          },
          {
            "id": 6319,
