        "attributes_json": "[\n  {\n    \"complex_id\": 0,\n    \"id\": 11650,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"原厂包装数量\",\n    \"_source\": \"系统默认：原厂包装数量 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6378,\n    \"values\": [\n      {\n        \"value\": \"30\"\n      }\n    ],\n    \"_name\": \"体积，升\",\n    \"_source\": \"Объем, л\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 23171,\n    \"values\": [\n      {\n        \"value\": \"#термосумка #сумка_холодильник #холодильная_сумка #изотермическая_сумка #термосумка_для_еды #сумка_для_продуктов #сумка_для_напитков #сумка_для_пикника #сумка_для_поездок #сумка_в_автомобиль #сумка_для_кемпинга #сумка_для_похода #сумка_для_рыбалки #сумка_для_дачи #сумка_на_пляж #для_отдыха_на_природе #для_активного_отдыха #для_семейного_пикника #для_горячей_еды #для_холодных_напитков #для_перевозки_продуктов #для_хранения_продуктов #контейнер_для_еды #изотермический_контейнер #сумка_с_термоизоляцией #сумка_на_молнии #сумка_с_карманом #сумка_для_лекарств #термосумка_для_обеда #сумка_из_ткани_оксфорд\"\n      }\n    ],\n    \"_name\": \"#主题标签\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4180,\n    \"values\": [\n      {\n        \"value\": \"Термосумка 30 л, сохраняет температуру до 24 часов, серая\"\n      }\n    ],\n    \"_name\": \"名称\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Изотермическая термосумка объемом 30 литров для хранения и перевозки продуктов, напитков и готовой еды. Сумка сохраняет исходную температуру содержимого до 24 часов при правильном использовании. Внешний материал — хлопок, PEVA и ткань Оксфорд 600. Внутри предусмотрена термоизоляционная прослойка из жемчужного хлопка и фольгированная светоотражающая ткань. Конструкция помогает сохранять как холод, так и тепло. Модель закрывается на молнию и оснащена одним просторным внутренним отделением, внешним карманом на молнии и боковыми сетчатыми карманами для бутылок и других мелочей. Ручки с липучкой удобны для переноски. Термосумка подойдет для пикника, поездок на автомобиле, дачи, рыбалки, кемпинга, походов, пляжа и отдыха на природе. В ней можно перевозить обеды, напитки, продукты, выпечку и другие товары, которым важно поддержание температуры. При необходимости допускается использование охлаждающих элементов, сухого или обычного льда. Размеры: 40 × 25 × 29 см. Вес — 435 г. Цвет — серый. Гарантия — 6 месяцев.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4383,\n    \"values\": [\n      {\n        \"value\": \"410\"\n      }\n    ],\n    \"_name\": \"商品重量，克\",\n    \"_source\": \"自动工作台：商品净重\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10096,\n    \"values\": [\n      {\n        \"value\": \"灰色\",\n        \"dictionary_value_id\": 61576\n      }\n    ],\n    \"_name\": \"商品颜色\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6383,\n    \"values\": [\n      {\n        \"value\": \"PEVA\",\n        \"dictionary_value_id\": 970625854\n      },\n      {\n        \"value\": \"棉花\",\n        \"dictionary_value_id\": 62174\n      },\n      {\n        \"value\": \"牛津600\",\n        \"dictionary_value_id\": 970867910\n      }\n    ],\n    \"_name\": \"材料\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4389,\n    \"values\": [\n      {\n        \"value\": \"中国\",\n        \"dictionary_value_id\": 90296\n      }\n    ],\n    \"_name\": \"原产国\",\n    \"_source\": \"系统默认：原产国 中国（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8414,\n    \"values\": [\n      {\n        \"value\": \"29\"\n      }\n    ],\n    \"_name\": \"高度，厘米\",\n    \"_source\": \"Высота, см\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10433,\n    \"values\": [\n      {\n        \"value\": \"珍珠棉\",\n        \"dictionary_value_id\": 970780659\n      }\n    ],\n    \"_name\": \"保温层\",\n    \"_source\": \"Термоизоляционная прослойка + Ozon字典精确匹配\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10400,\n    \"values\": [\n      {\n        \"value\": \"1 年\",\n        \"dictionary_value_id\": 970716397\n      }\n    ],\n    \"_name\": \"保证\",\n    \"_source\": \"系统默认：保证 1 年（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10097,\n    \"values\": [\n      {\n        \"value\": \"серый\"\n      }\n    ],\n    \"_name\": \"颜色名称\",\n    \"_source\": \"AI映射页面事实：В характеристиках указан цвет Серый\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9048,\n    \"values\": [\n      {\n        \"value\": \"AUTO-20260902-E30BBC\"\n      }\n    ],\n    \"_name\": \"型号名称（针对合并为一张商品卡片）\",\n    \"_source\": \"人工填写：型号名称（合并多变体）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8061,\n    \"values\": [\n      {\n        \"value\": \"40\"\n      }\n    ],\n    \"_name\": \"宽度，厘米\",\n    \"_source\": \"Ширина, см\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10453,\n    \"values\": [\n      {\n        \"value\": \"24\"\n      }\n    ],\n    \"_name\": \"保温时间， h\",\n    \"_source\": \"Время сохранения температуры, ч\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4790,\n    \"values\": [\n      {\n        \"value\": \"25\"\n      }\n    ],\n    \"_name\": \"深度，厘米\",\n    \"_source\": \"Глубина, см\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 85,\n    \"values\": [\n      {\n        \"value\": \"Нет бренда\",\n        \"dictionary_value_id\": 126745801\n      }\n    ],\n    \"_name\": \"品牌\",\n    \"_source\": \"系统锁定：无品牌\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 23366,\n    \"values\": [\n      {\n        \"value\": \"热包\",\n        \"dictionary_value_id\": 972864091\n      }\n    ],\n    \"_name\": \"保温袋类型\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8229,\n    \"values\": [\n      {\n        \"value\": \"保暖袋\",\n        \"dictiona