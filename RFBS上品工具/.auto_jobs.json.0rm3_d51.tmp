ию дождя и UV-излучения. Камуфляжная расцветка помогает скрыться на фоне леса или поля. Сетку можно использовать для создания укрытий, защиты от солнца, в пейнтболе, для декора и в качестве фона для фотосессий. Подходит как опытным охотникам, так и любителям активного отдыха.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8229,\n    \"values\": [\n      {\n        \"value\": \"狩猎伪装\",\n        \"dictionary_value_id\": 970827604\n      }\n    ],\n    \"_name\": \"类型\",\n    \"_source\": \"Тип + Ozon字典精确匹配\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 11650,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"原厂包装数量\",\n    \"_source\": \"系统默认：原厂包装数量 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4383,\n    \"values\": [\n      {\n        \"value\": \"1150\"\n      }\n    ],\n    \"_name\": \"商品重量，克\",\n    \"_source\": \"自动工作台：商品净重\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 23171,\n    \"values\": [\n      {\n        \"value\": \"#маскировочная_сетка #сетка_для_охоты #камуфляжная_сетка #маскировочная_сеть #сетка_камуфляж_для_охоты #охотничья_масксеть #сетка_для_укрытия #укрытие_для_охоты #сетка_для_засидки #камуфляж_для_засидки #сетка_для_пейнтбола #сетка_для_активного_отдыха #сетка_для_туризма #сетка_для_фотосессии #камуфляжный_фон_для_фото #сетка_для_декора #сетка_от_солнца #защита_от_солнца_на_природе #сетка_для_леса #сетка_для_поля #маскировка_в_лесу #маскировка_на_природе #снаряжение_для_охоты #товары_для_охоты #туристическое_укрытие #полевое_укрытие #сетка_для_отдыха_на_природе #камуфляж_для_фотосъемки\"\n      }\n    ],\n    \"_name\": \"#主题标签\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 7826,\n    \"values\": [\n      {\n        \"value\": \"专家\",\n        \"dictionary_value_id\": 22705\n      }\n    ],\n    \"_name\": \"目标受众\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n 