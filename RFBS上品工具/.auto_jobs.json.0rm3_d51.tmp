            "group_name_ru": ""
          },
          {
            "id": 6036,
            "attribute_complex_id": 0,
            "name": "使用寿命，年数",
            "description": "在不影响消费者质量和安全的情况下，产品可以根据其功能使用的最长时间。 您只能指定整数或十进制数。 分隔符是一个点。",
            "type": "Decimal",
            "is_collection": false,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "",
