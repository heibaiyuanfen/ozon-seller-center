x_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Декоративный уличный светильник в форме чайника с пастушьим крюком работает от солнечной энергии. Оснащён тёплым белым светодиодом и гирляндой, создающей мерцающее освещение. Днём светильник автоматически заряжается при достаточном освещении, а ночью включается благодаря датчику освещённости. Подходит для двора, сада, дорожек, окон, витрин и оформления зон отдыха. Светильник имеет защиту IP65 от пыли и влаги, не требует проводов и крепится на кронштейн или крюк.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4383,\n    \"values\": [\n      {\n        \"value\": \"445.0\"\n      }\n    ],\n    \"_name\": \"商品重量，克\",\n    \"_source\": \"自动工作台：商品净重\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4386,\n    \"values\": [\n      {\n        \"value\": \"纸箱\",\n        \"dictionary_value_id\": 85921\n      }\n    ],\n    \"_name\": \"包装\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8962,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"一个商品中的件数\",\n    \"_source\": \"系统默认：一个商品中的件数 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6605,\n    \"values\": [\n      {\n        \"value\": \"120\"\n      }\n    ],\n    \"_name\": \"宽度，毫米\",\n    \"_source\": \"Ширина, мм\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6326,\n    \"values\": [\n      {\n        \"value\": \"自动开机\",\n        \"dictionary_value_id\": 11841\n      },\n      {\n        \"value\": \"带光传感器\",\n        \"dictionary_value_id\": 971360957\n      }\n    ],\n    \"_name\": \"固定装置的特点\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 12138,\n    \"values\": [\n      {\n        \"value\": \"是的\",\n        \"dictionary_value_id\": 970701879\n      }\n    ],\n    \"_name\": \"全套灯泡\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n