        "attributes_json": "[\n  {\n    \"complex_id\": 0,\n    \"id\": 6898,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"安装孔数\",\n    \"_source\": \"Количество монтажных отверстий\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9048,\n    \"values\": [\n      {\n        \"value\": \"AUTO-20260818-C729A8\"\n      }\n    ],\n    \"_name\": \"型号名称（针对合并为一张商品卡片）\",\n    \"_source\": \"人工填写：型号名称（合并多变体）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 85,\n    \"values\": [\n      {\n        \"value\": \"Нет бренда\",\n        \"dictionary_value_id\": 126745801\n      }\n    ],\n    \"_name\": \"品牌\",\n    \"_source\": \"系统锁定：无品牌\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4180,\n    \"values\": [\n      {\n        \"value\": \"Смеситель для кухни с гибким изливом и краном для фильтра, графит\"\n      }\n    ],\n    \"_name\": \"名称\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4383,\n    \"values\": [\n      {\n        \"value\": \"2345\"\n      }\n    ],\n    \"_name\": \"商品重量，克\",\n    \"_source\": \"自动工作台：商品净重\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 11650,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"原厂包装数量\",\n    \"_source\": \"系统默认：原厂包装数量 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6896,\n    \"values\": [\n      {\n        \"value\": \"35\"\n      }\n    ],\n    \"_name\": \"安装孔直径，mm\",\n    \"_source\": \"Диаметр монтажных отверстий, мм\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10400,\n    \"values\": [\n      {\n        \"value\": \"1 年\",\n        \"dictionary_value_id\": 970716397\n      }\n    ],\n    \"_name\": \"保证\",\n    \"_source\": \"系统默认：保证 1 年（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9710,\n    \"values\": [\n      {\n        \"value\": \"230\"\n      }\n    ],\n    \"_name\": \"喷口长度，mm\",\n    \"_source\": \"Длина излива, мм\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4497,\n    \"values\": [\n      {\n        \"value\": \"2345\"\n      }\n    ],\n    \"_name\": \"含包装重量，克\",\n    \"_source\": \"Вес с упаковкой, г\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6383,\n    \"values\": [\n      {\n        \"value\": \"不锈钢\",\n        \"dictionary_value_id\": 61969\n      }\n    ],\n    \"_name\": \"材料\",\n    \"_source\": \"Материал + Ozon字典精确匹配\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10096,\n    \"values\": [\n      {\n        \"value\": \"黑色\",\n        \"dictionary_value_id\": 61574\n      },\n      {\n        \"value\": \"灰色\",\n        \"dictionary_value_id\": 61576\n      }\n    ],\n    \"_name\": \"商品颜色\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9721,\n    \"values\": [\n      {\n        \"value\": \"14\"\n      }\n    ],\n    \"_name\": \"耗水量，l/min\",\n    \"_source\": \"Расход воды, л/мин\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6894,\n    \"values\": [\n      {\n        \"value\": \"237\"\n      }\n    ],\n    \"_name\": \"喷口高度，mm\",\n    \"_source\": \"Высота излива, мм\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4384,\n    \"values\": [\n      {\n        \"value\": \"Смеситель, прорезиненное уплотнительное кольцо, прокладка, крепеж, гибкая подводка для холодной и горячей воды, трубка для фильтрованной воды, пластиковый переходник для фильтра\"\n      }\n    ],\n    \"_name\": \"配套\",\n    \"_source\": \"AI映射页面事实：Комплектация указана в характеристиках\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Кухонный смеситель графитового цвета с гибким поворотным изливом и отдельной подачей питьевой воды от фильтра. Корпус выполнен из нержавеющей стали с матовым защитным покрытием. Гибкий излив можно направлять в нужную сторону — удобно для мытья посуды, овощей, фруктов, кастрюль и сковородок. Основной рычаг служит для регулировки температуры и напора воды, отдельная рукоять — для подачи фильтрованной воды. Керамический картридж обеспечивает точную настройку потока. Аэратор смешивает воду с воздухом, помогая уменьшить разбрызгивание и расход воды. Смеситель устанавливается на раковину или столешницу в одно монтажное отверстие. В комплект входят смеситель, прорезиненное уплотнительное кольцо, прокладка, крепеж, гибкая подводка для холодной и горячей воды, трубка для фильтрованной воды и пластиковый переходник для фильтра.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4389,\n    \"values\": [\n      {\n        \"value\": \"中国\",\n        \"dictionary_value_id\": 90296\n      }\n    ],\n    \"_name\": \"原产国\",\n    \"_source\": \"系统默认：原产国 中国（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10097,\n    \"values\": [\n      {\n        \"value\": \"Графитовый / черный\"\n      }\n    ],\n    \"_name\": \"颜色名称\",\n    \"_source\": \"AI映射页面事实：Цвет товара\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 23171,\n    \"values\": [\n      {\n        \"value\": \"#смеситель_для_кухни #кухонный_смеситель #кран_для_кухни #смеситель_для_кухонной_мойки #смеситель_для_раковины #кухонный_кран #гибкий_смеситель_для_кухни #смеситель_с_гибким_изливом #смеситель_для_фильтра_воды #кран_под_фильтр_воды #кран_для_питьевой_воды #смеситель_с_питьевой_водой #кран_для_фильтрованной_воды #смеситель_с_отдельным_краном #поворотный_смеситель #смеситель_с_аэратором #стальной_смеситель #матовый_смеситель #смеситель_на_столешницу #смеситель_на_раковину #смеситель_с_рычагом #кран_с_керамическим #кран_для_мытья_посуды #кран_для_мытья_овощей #кран_для_мытья_фруктов #смеситель_для_кастрюль #смеситель_для_сковородок #смеситель_для_дома\"\n      }\n    ],\n    \"_name\": \"#主题标签\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6903,\n    \"values\": [\n      {\n        \"value\": \"1/2\\\" x 1/2\\\"\",\n        \"dictionary_value_id\": 970664063\n      }\n    ],\n    \"_name\": \"软管连接标准\",\n    \"_source\": \"Стандарт подводки шланга + Ozon字典精确匹配\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9802,\n    \"values\": [\n      {\n        \"value\": \"265\"\n      }\n    ],\n    \"_name\": \"长度，毫米\",\n    \"_source\": \"Длина, мм\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 21494,\n    \"values\": [\n      {\n        \"value\": \"在螺母上\",\n        \"dictionary_value_id\": 971156217\n      }\n    ],\n    \"_name\": \"混合器附件类型\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10393,\n    \"values\": [\n      {\n        \"value\": \"陶瓷滤芯\",\n        \"dictionary_value_id\": 970715755\n      }\n    ],\n    \"_name\": \"混合器截止阀\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10573,\n    \"values\": [\n      {\n        \"value\": \"1\",\n        \"dictionary_value_id\": 970729508\n      }\n    ],\n    \"_name\": \"水龙头孔\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6888,\n    \"values\": [\n      {\n        \"value\": \"用于厨房水槽\",\n        \"dictionary_value_id\": 64773\n      },\n      {\n        \"value\": \"用于水槽\",\n        \"dictionary_value_id\": 718741394\n      }\n    ],\n    \"_name\": \"用途\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 22127,\n    \"values\": [\n      {\n        \"value\": \"带喷嘴\",\n        \"dictionary_value_id\": 971314341\n      }\n    ],\n    \"_name\": \"喷口的存在\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 21385,\n    \"values\": [\n      {\n        \"value\": \"防腐\",\n        \"dictionary_value_id\": 971151741\n      },\n      {\n        \"value\": \"保护\",\n        \"dictionary_value_id\": 971151748\n      },\n      {\n        \"value\": \"磨 砂\",\n        \"dictionary_value_id\": 971151751\n      }\n    ],\n    \"_name\": \"保障范围\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 