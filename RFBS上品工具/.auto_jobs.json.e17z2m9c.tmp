d\": 23171,\n    \"values\": [\n      {\n        \"value\": \"#перчатка_для_удаления_шерсти #антистатическая_перчатка #перчатка_для_вычесывания #перчатка_для_кошек #перчатка_для_собак #расческа_перчатка #варежка_для_сбора_шерсти #средство_для_удаления_шерсти #сборщик_шерсти_животных #щетка_перчатка_для_кошек #щетка_перчатка_для_собак #расческа_для_кошек #расческа_для_собак #вычесывание_кошек #вычесывание_собак #уход_за_шерстью_кошек #уход_за_шерстью_собак #мягкая_расческа_для_животных #массажная_перчатка #перчатка_для_мебели_от_шерсти #удаление_шерсти_с_дивана #удаление_шерсти_с_одежды #удаление_шерсти_с_ковра #уборка_шерсти_животных #товары_для_ухода_за_животными #уход_за_питомцем #для_дома_с_животными #перчатка_для_автосидений\"\n      }\n    ],\n    \"_name\": \"#主题标签\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8962,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"一个商品中的件数\",\n    \"_source\": \"系统默认：一个商品中的件数 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 85,\n    \"values\": [\n      {\n        \"value\": \"Нет бренда\",\n        \"dictionary_value_id\": 126745801\n      }\n    ],\n    \"_name\": \"品牌\",\n    \"_source\": \"系统锁定：无品牌\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 20818,\n    \"values\": [\n      {\n        \"value\": \"普通\",\n        \"dictionary_value_id\": 971083607\n      }\n    ],\n    \"_name\": \"梳齿的类型\",\n    \"_source\": \"Вид зубьев у расчески + Ozon字典精确匹配\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4389,\n    \"values\": [\n      {\n        \"value\": \"中国\",\n        \"dictionary_value_id\": 90296\n      }\n    ],\n    \"_name\": \"原产国\",\n    \"_source\": \"系统默认：原产国 中国（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Мягкая антистатическая перчатка-расческа для ухода за шерстью и кожей кошек и собак. Электростатический эффект помогает собирать шерсть и пыль при поглаживании питомца, а также при уборке мягкой мебели, ковров, подушек, одежды и автомобильных сидений. Собранную шерсть можно снять с поверхности перчатки, затем промыть ее и высушить. Подходит для короткой и длинной шерсти, включая подшерсток. Многоразовая перчатка выполнена в черном цвете.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 5968,\n    \"values\": [\n      {\n        \"value\": \"头发和皮肤护理\",\n        \"dictionary_value_id\": 57925\n      }\n    ],\n    \"_name\": \"护理类型\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4958,\n    \"values\": [\n      {\n        \"value\": \"对于狗\",\n        \"dictionary_value_id\": 33746\n      },\n      {\n        \"value\": \"猫咪用品\",\n        \"dictionary_value_id\": 33754\n      }\n    ],\n    \"_name\": \"专为\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8229,\n    \"values\": [\n      {\n        \"value\": \"动物梳子\",\n        \"dictionary_value_id\": 95249\n      }\n    ],\n    \"_name\": \"类型\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4386,\n    \"values\": [\n      {\n        \"value\": \"袋\",\n        \"dictionary_value_id\": 85876\n      }\n    ],\n    \"_name\": \"包装\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 23294,\n    \"values\": [\n      {\n        \"value\": \"手套\",\n        \"dictionary_value_id\": 972854984\n      }\n    ],\n    \"_name\": \"一种梳毛梳\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 5838,\n    \"values\": [\n      {\n        \"value\": \"软\",\n        \"dictionary_value_id\": 2481\n      }\n    ],\n    \"_name\": \"刚性;刚性\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  }\n]",
