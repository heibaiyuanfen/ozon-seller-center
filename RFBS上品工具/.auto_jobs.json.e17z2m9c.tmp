        "attributes_json": "[\n  {\n    \"complex_id\": 0,\n    \"id\": 4082,\n    \"values\": [\n      {\n        \"value\": \"19*11*5\"\n      }\n    ],\n    \"_name\": \"包装尺寸（长X宽x高），厘米\",\n    \"_source\": \"Размер упаковки (Длина х Ширина х Высота), см\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4382,\n    \"values\": [\n      {\n        \"value\": \"190\"\n      }\n    ],\n    \"_name\": \"尺寸，毫米\",\n    \"_source\": \"Размеры, мм\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 11043,\n    \"values\": [\n      {\n        \"value\": \"230\"\n      }\n    ],\n    \"_name\": \"齿数，个。\",\n    \"_source\": \"Количество зубьев, шт.\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 85,\n    \"values\": [\n      {\n        \"value\": \"Нет бренда\",\n        \"dictionary_value_id\": 126745801\n      }\n    ],\n    \"_name\": \"品牌\",\n    \"_source\": \"系统锁定：无品牌\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4967,\n    \"values\": [\n      {\n        \"value\": \"塑料\",\n        \"dictionary_value_id\": 62015\n      },\n      {\n        \"value\": \"不锈钢\",\n        \"dictionary_value_id\": 61969\n      },\n      {\n        \"value\": \"镀膜不锈钢\",\n        \"dictionary_value_id\": 61971\n      }\n    ],\n    \"_name\": \"材料\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10096,\n    \"values\": [\n      {\n        \"value\": \"浅灰色\",\n        \"dictionary_value_id\": 61594\n      },\n      {\n        \"value\": \"白色\",\n        \"dictionary_value_id\": 61571\n      },\n      {\n        \"value\": \"灰色\",\n        \"dictionary_value_id\": 61576\n      }\n    ],\n    \"_name\": \"商品颜色\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4383,\n    \"values\": [\n      {\n        \"value\": \"82\"\n      }\n    ],\n    \"_name\": \"商品重量，克\",\n    \"_source\": \"自动工作台：商品净重\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 23171,\n    \"values\": [\n      {\n        \"value\": \"#расческа_для_животных #пуходерка_для_кошек #пуходерка_для_собак #расческа_для_кошек #расческа_для_собак #чесалка_для_кошек #чесалка_для_собак #гребень_для_животных #дешеддер_для_кошек #дешеддер_для_собак #уход_за_шерстью_животных #уход_за_шерстью_кошек #уход_за_шерстью_собак #вычесывание_шерсти #удаление_лишней_шерсти #расческа_для_подшерстка #уход_за_кожей_питомца #массаж_для_кошек #массаж_для_собак #расческа_самоочистка #инструмент_для_груминга #груминг_кошек #груминг_собак #уход_за_питомцем #товары_для_кошек #товары_для_собак #аксессуары_для_животных #расческа_против_колтунов\"\n      }\n    ],\n    \"_name\": \"#主题标签\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 11650,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"原厂包装数量\",\n    \"_source\": \"系统默认：原厂包装数量 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9048,\n    \"values\": [\n      {\n        \"value\": \"AUTO-20260828-F298A7\"\n      }\n    ],\n    \"_name\": \"型号名称（针对合并为一张商品卡片）\",\n    \"_source\": \"人工填写：型号名称（合并多变体）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4180,\n    \"values\": [\n      {\n        \"value\": \"Пуходерка-расческа для кошек и собак с кнопкой самоочистки\"\n      }\n    ],\n    \"_name\": \"名称\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4389,\n    \"values\": [\n      {\n        \"value\": \"中国\",\n        \"dictionary_value_id\": 90296\n      }\n    ],\n    \"_name\": \"原产国\",\n    \"_source\": \"系统默认：原产国 中国（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10400,\n    \"values\": [\n      {\n        \"value\": \"1 年\",\n        \"dictionary_value_id\": 970716397\n      }\n    ],\n    \"_name\": \"保证\",\n    \"_source\": \"系统默认：保证 1 年（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8962,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"一个商品中的件数\",\n    \"_source\": \"系统默认：一个商品中的件数 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Пуходерка предназначена для ухода за шерстью и кожей кошек и собак. Расческа со средней жесткостью помогает удалять лишнюю шерсть и подшерсток, вычесывать питомца, поддерживать шерсть в порядке и предотвращать образование колтунов. Зубья с защитой на кончиках снижают риск раздражения и царапин кожи. Удобная ручка обеспечивает надежный захват, а кнопка самоочистки облегчает удаление шерсти с зубьев. Подходит для регулярного ухода и легкого массажа. Материалы: пластик, нержавеющая сталь с покрытием. Количество зубьев — 230. Размер — 190 мм, вес — 105 г. В комплекте 1 расческа. Гарантия — 1 месяц.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4958,\n    \"values\": [\n      {\n        \"value\": \"对于狗\",\n        \"dictionary_value_id\": 33746\n      },\n      {\n        \"value\": \"猫咪用品\",\n        \"dictionary_value_id\": 33754\n      }\n    ],\n    \"_name\": \"专为\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 5838,\n    \"values\": [\n      {\n        \"value\": \"中等\",\n        \"dictionary_value_id\": 2482\n      }\n    ],\n    \"_name\": \"刚性;刚性\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8229,\n    \"values\": [\n      {\n        \"value\": \"动物梳子\",\n        \"dictionary_value_id\": 95249\n      }\n    ],\n    \"_name\": \"类型\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4386,\n    \"values\": [\n      {\n        \"value\": \"袋\",\n        \"dictionary_value_id\": 85876\n      }\n    ],\n    \"_name\": \"包装\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 23294,\n    \"values\": [\n      {\n        \"value\": \"刷毛梳\",\n        \"dictionary_value_id\": 972854985\n      }\n    ],\n    \"_name\": \"一种梳毛梳\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n