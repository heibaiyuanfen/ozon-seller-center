ерской #инструмент_для_гаража #гаражный_ручной_инструмент #инструмент_для_ремонта #инструмент_для_слесаря #для_слесарных_работ #для_ремонтных_работ #для_домашней_мастерской #для_гаражных_работ #прочный_слесарный_инструмент #износостойкий_инструмент #стальной_боек_молотка #рукоятка_из_стеклопластика #термопластичная_рукоятка #обрезиненный_слесарный\"\n      }\n    ],\n    \"_name\": \"#主题标签\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Слесарный молоток VIRA с бойком из углеродистой стали CS45 предназначен для слесарных работ. Вес бойка — 500 г, общий вес инструмента — 690 г, длина — 325 мм. Рабочая часть плотно соединена с рукояткой. Рукоятка выполнена из стеклопластикового стержня и покрыта термопластичной резиной TPR: покрытие мягкое на ощупь и помогает надежно удерживать инструмент в руке. Квадратная форма бойка удобна для выполнения ударных работ. Перед использованием проверьте целостность и исправность молотка. Работайте аккуратно, удерживайте инструмент крепко и не используйте его в опасной близости от людей.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4383,\n    \"values\": [\n      {\n        \"value\": \"693\"\n      }\n    ],\n    \"_name\": \"商品重量，克\",\n    \"_source\": \"自动工作台：商品净重\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4389,\n    \"values\": [\n      {\n        \"value\": \"中国\",\n        \"dictionary_value_id\": 90296\n      }\n    ],\n    \"_name\": \"原产国\",\n    \"_source\": \"系统默认：原产国 中国（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 85,\n    \"values\": [\n      {\n        \"value\": \"Нет бренда\",\n        \"dictionary_value_id\": 126745801\n      }\n    ],\n    \"_name\": \"品牌\",\n    \"_source\": \"系统锁定：无品牌\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 11650,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"原厂包装数量\",\