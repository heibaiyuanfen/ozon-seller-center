        "attributes_json": "[\n  {\n    \"complex_id\": 0,\n    \"id\": 6873,\n    \"values\": [\n      {\n        \"value\": \"14\"\n      }\n    ],\n    \"_name\": \"隔层数量，个\",\n    \"_source\": \"Число отделений, шт\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4383,\n    \"values\": [\n      {\n        \"value\": \"50\"\n      }\n    ],\n    \"_name\": \"商品重量，克\",\n    \"_source\": \"自动工作台：商品净重\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6287,\n    \"values\": [\n      {\n        \"value\": \"0.5\"\n      }\n    ],\n    \"_name\": \"主隔层容积，l\",\n    \"_source\": \"Объем главного отделения, л\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10096,\n    \"values\": [\n      {\n        \"value\": \"黑色\",\n        \"dictionary_value_id\": 61574\n      },\n      {\n        \"value\": \"红色\",\n        \"dictionary_value_id\": 61579\n      }\n    ],\n    \"_name\": \"商品颜色\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Сумка-скрутка предназначена для хранения набора комбинированных ключей и других инструментов. В конструкции предусмотрено 14 отдельных карманов с внутренними разделителями, чтобы инструменты были аккуратно размещены и быстро доступны. Закрытая конструкция карманов помогает защитить содержимое от пыли. Сумка выполнена из брезента, оснащена подвесным шнуром и может крепиться к ремню или рюкзаку. Подходит для домашнего ремонта, небольших проектов, ремонта автомобилей, работы на улице, путешествий и кемпинга. Размер — около 55×35 см, объем главного отделения — 0,5 л, максимальная нагрузка — 10 кг. Цвет — черный, красный. В комплекте: 1 сумка для набора комбинированных ключей. Гарантия не предоставляется.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8416,\n    \"values\": [\n      {\n        \"value\": \"35\"\n      }\n    ],\n    \"_name\": \"宽度，厘米\",\n    \"_source\": \"Ширина, см\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4384,\n    \"values\": [\n      {\n        \"value\": \"Сумка для набора комбинированных ключей\"\n      }\n    ],\n    \"_name\": \"配套\",\n    \"_source\": \"AI映射页面事实：Комплектация: 1 шт. сумка.\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 85,\n    \"values\": [\n      {\n        \"value\": \"Нет бренда\",\n        \"dictionary_value_id\": 126745801\n      }\n    ],\n    \"_name\": \"品牌\",\n    \"_source\": \"系统锁定：无品牌\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 7915,\n    \"values\": [\n      {\n        \"value\": \"10\"\n      }\n    ],\n    \"_name\": \"麦克斯。负载，kg\",\n    \"_source\": \"Макс. нагрузка, кг\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 11650,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"原厂包装数量\",\n    \"_source\": \"系统默认：原厂包装数量 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 23171,\n    \"values\": [\n      {\n        \"value\": \"#сумка_для_строительных #сумка_для_комбинированных #сумка_скрутка_для_инструмента #органайзер_для_инструментов #сумка_для_инструмента #чехол_для_инструментов #сумка_для_гаечных_ключей #органайзер_для_ключей #чехол_для_гаечных_ключей #ролл_для_инструментов #инструментальная_сумка #органайзер #хранение_инструментов #сумка_для_ремонта #для_домашнего_ремонта #для_ремонта_автомобиля #для_работы_на_улице #для_кемпинга #для_путешествий #для_домашнего_хозяйства #для_небольших_проектов #сумка_на_ремень #сумка_на_рюкзак #сумка_с_отделениями #сумка_с_подвесным_шнуром #сумка_из_брезента #закрытая_сумка #сумка_для_хранения_ключей\"\n      }\n    ],\n    \"_name\": \"#主题标签\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9048,\n    \"values\": [\n      {\n        \"value\": \"AUTO-2\"\n      }\n    ],\n    \"_name\": \"型号名称（针对合并为一张商品卡片）\",\n    \"_source\": \"人工填写：型号名称（合并多变体）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8415,\n    \"values\": [\n      {\n        \"value\": \"55\"\n      }\n 