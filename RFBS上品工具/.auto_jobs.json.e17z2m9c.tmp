        "attributes_json": "[\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Маскировочная сеть для охоты коричневого камуфляжного цвета. Размер — 4×6 м. Изготовлена из материала оксфорд, отличается плотностью и устойчивостью к механическим повреждениям. Помогает создать естественный фон на местности для стационарного размещения или мобильных задач в поле. Компактный формат упаковки удобен для переноски в рюкзаке.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 85,\n    \"values\": [\n      {\n        \"value\": \"Нет бренда\",\n        \"dictionary_value_id\": 126745801\n      }\n    ],\n    \"_name\": \"品牌\",\n    \"_source\": \"系统锁定：无品牌\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9048,\n    \"values\": [\n      {\n        \"value\": \"AUTO-20260818-6174A7\"\n      }\n    ],\n    \"_name\": \"型号名称（针对合并为一张商品卡片）\",\n    \"_source\": \"人工填写：型号名称（合并多变体）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10097,\n    \"values\": [\n      {\n        \"value\": \"Коричневый камуфляж\"\n      }\n    ],\n    \"_name\": \"颜色名称\",\n    \"_source\": \"AI映射页面事实：В характеристиках указан цвет «Коричневый комуфляж».\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 23171,\n    \"values\": [\n      {\n        \"value\": \"#маскировочная_сеть_для_охоты #охотничья_маскировочная_сеть #сеть_для_маскировки #камуфляжная_сеть #маскировка_для_охоты #охотничий_камуфляж #сеть_для_засидки #маскировка_для_засидки #сеть_для_укрытия_на_охоте #камуфляж_для_охотника #охотничье_укрытие #сеть_для_полевой_маскировки #маскировка_в_лесу #маскировка_на_природе #сеть_для_охотничьего_лагеря #сеть_для_наблюдения_за #камуфляжное_укрытие #сеть_для_стационарной #переносная_маскировочная_сеть #коричневая_маскировочная_сеть #коричневая_камуфляжная_сеть #маскировочная_сеть_оксфорд #камуфляжная_ткань_для_укрытия #сеть_для_охотничьих #маскировка_для_поля #маскировочная_сеть #охотничье_снаря