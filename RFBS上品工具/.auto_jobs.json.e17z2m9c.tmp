        "attributes_json": "[\n  {\n    \"complex_id\": 0,\n    \"id\": 10400,\n    \"values\": [\n      {\n        \"value\": \"1 年\",\n        \"dictionary_value_id\": 970716397\n      }\n    ],\n    \"_name\": \"保证\",\n    \"_source\": \"系统默认：保证 1 年（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6378,\n    \"values\": [\n      {\n        \"value\": \"30\"\n      }\n    ],\n    \"_name\": \"体积，升\",\n    \"_source\": \"Объем, л\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10433,\n    \"values\": [\n      {\n        \"value\": \"珍珠棉\",\n        \"dictionary_value_id\": 970780659\n      }\n    ],\n    \"_name\": \"保温层\",\n    \"_source\": \"Термоизоляционная прослойка + Ozon字典精确匹配\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Изотермическая термосумка серого цвета объёмом 30 л предназначена для перевозки и временного хранения продуктов и напитков. Сумка сохраняет температуру содержимого до 24 часов при правильном использовании и подходит для холодных и горячих продуктов. В конструкции используется термоизоляционная прослойка из жемчужного хлопка, а также материалы хлопок, PEVA и Оксфорд 600. Внутренняя трёхслойная изоляция толщиной 9 мм помогает поддерживать температурный режим. Фольгированная светоотражающая ткань способствует сохранению тепла и прохлады. Модель оснащена одним просторным внутренним отделением, внешним карманом на молнии и боковыми сетчатыми карманами для бутылок и мелочей. Молния обеспечивает удобный доступ к содержимому, ручки с липучкой облегчают переноску. Термосумка пригодится для пикника, поездок на автомобиле, отдыха на природе, кемпинга, рыбалки, дачи и пляжа. Размеры изделия: 40 × 25 × 29 см. Вес — 435 г. Цвет: серый. Гарантия — 6 месяцев.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 85,\n    \"values\": [\n      {\n        \"value\": \"Нет бренда\",\n        \"dictionary_value_id\": 126745801\n      }\n    ],\n    \"_name\": \"品牌\",\n    \"_source\": \"系统锁定：无品牌\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10097,\n    \"values\": [\n      {\n        \"value\": \"Серый Красивый цвет R513\"\n      }\n    ],\n    \"_name\": \"颜色名称\",\n    \"_source\": \"AI映射页面事实：Указание цвета в характеристиках товара\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6383,\n    \"values\": [\n      {\n        \"value\": \"PEVA\",\n        \"dictionary_value_id\": 970625854\n      },\n      {\n        \"value\": \"棉花\",\n        \"dictionary_value_id\": 62174\n      },\n      {\n        \"value\": \"牛津600\",\n        \"dictionary_value_id\": 970867910\n      }\n    ],\n    \"_name\": \"材料\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10453,\n    \"values\": [\n      {\n        \"value\": \"24\"\n      }\n    ],\n    \"_name\": \"保温时间， h\",\n    \"_source\": \"Время сохранения температуры, ч\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4383,\n    \"values\": [\n      {\n        \"value\": \"410\"\n      }\n    ],\n    \"_name\": \"商品重量，克\",\n    \"_source\": \"自动工作台：商品净重\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 11650,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"原厂包装数量\",\n    \"_source\": \"系统默认：原厂包装数量 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4389,\n    \"values\": [\n      {\n        \"value\": \"中国\",\n        \"dictionary_value_id\": 90296\n      }\n    ],\n    \"_name\": \"原产国\",\n    \"_source\": \"系统默认：原产国 中国（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4790,\n    \"values\": [\n      {\n        \"value\": \"25\"\n      }\n    ],\n    \"_name\": \"深度，厘米\",\n    \"_source\": \"Глубина, см\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8414,\n    \"values\": [\n      {\n        \"value\": \"29\"\n      }\n    ],\n    \"_name\": \"高度，厘米\",\n    \"_source\": \"Высота, см\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8061,\n    \"val