          "model_name": "AUTO-0828-1",
          "image_prompt": "Create a polished category-appropriate marketplace scene with designed lighting, natural depth, strong product separation and a controlled palette.",
          "watermark_path": "D:/OZON 跟卖软件/Ozon_RFBS上品工具/eb8c7335ff22b878b4fa13c18cce4507.png",
          "category_display": "宠物用品 / 宠物护理用品 / 动物梳子",
          "category_id": "17028968",
          "type_id": "95249",
          "warehouse_id": "1020002623569000",
