дской ткани: материал устойчив к износу и воздействию влаги, а поверхность легко очищается влажной тканью. Одно основное отделение и внешние карманы помогают организовать инструменты и быстро находить нужные принадлежности. Эргономичная ручка облегчает переноску, усиленное дно и надежные швы повышают прочность изделия. Размер сумки — 32×18×22 см. Цвет: черный матовый или темно-синий. Гарантия не предоставляется.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 23171,\n    \"values\": [\n      {\n        \"value\": \"#сумка_для_инструментов #сумка_для_стройинструмента #сумка_строительная #сумка_рабочая #сумка_для_ручного_инструмента #сумка_монтажника #сумка_плотника #органайзер_для_инструмента #чехол_для_инструмента #контейнер_для_инструмента #сумка_для_ремонта #сумка_для_домашнего_ремонта #сумка_для_гаража #сумка_для_мастерской #сумка_для_работы #переноска_инструмента #хранение_инструмента #сумка_с_карманами #сумка_с_ручкой #сумка_с_усиленным_дном #водостойкая_сумка #сумка_из_оксфорда #сумка_для_стройки #инструментальная_сумка #сумка_для_мастера #сумка_для_ремонта_дома #сумка_в_гараж\"\n      }\n    ],\n    \"_name\": \"#主题标签\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9048,\n    \"values\": [\n      {\n        \"value\": \"AUTO-0831-1\"\n      }\n    ],\n    \"_name\": \"型号名称（针对合并为一张商品卡片）\",\n    \"_source\": \"人工填写：型号名称（合并多变体）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8416,\n    \"values\": [\n      {\n        \"value\": \"18\"\n      }\n    ],\n    \"_name\": \"宽度，厘米\",\n    \"_source\": \"Ширина, см\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 8414,\n    \"values\": [\n      {\n        \"value\": \"22\"\n      }\n    ],\n    \"_name\": \"高度，厘米\",\n    \"_source\": \"Высота, см\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6881,\n    \"values\": [\n      {\n        \"value\": \"符合人体工程学的提手\",\n        \"dictionary_value_id\": 24088\n      },\n   