          {
            "id": 21841,
            "attribute_complex_id": 100001,
            "name": "臭氧。视频：链接",
            "description": "指定视频（MP4，MOV）的链接。 持续时间从8秒到5分钟，文件大小不超过2GB",
            "type": "String",
            "is_collection": false,
