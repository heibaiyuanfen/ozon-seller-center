  }\n    ],\n    \"_name\": \"安装孔数\",\n    \"_source\": \"Количество монтажных отверстий\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4389,\n    \"values\": [\n      {\n        \"value\": \"中国\",\n        \"dictionary_value_id\": 90296\n      }\n    ],\n    \"_name\": \"原产国\",\n    \"_source\": \"系统默认：原产国 中国（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9048,\n    \"values\": [\n      {\n        \"value\": \"AUTO-20260807-27F9E6\"\n      }\n    ],\n    \"_name\": \"型号名称（针对合并为一张商品卡片）\",\n    \"_source\": \"人工填写：型号名称（合并多变体）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6903,\n    \"values\": [\n      {\n        \"value\": \"1/2\\\"\",\n        \"dictionary_value_id\": 971368187\n      }\n    ],\n    \"_name\": \"软管连接标准\",\n    \"_source\": \"Стандарт подводки шланга + Ozon字典精确匹配\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 6896,\n    \"values\": [\n      {\n        \"value\": \"46\"\n      }\n    ],\n    \"_name\": \"安装孔直径，mm\",\n    \"_source\": \"Диаметр монтажных отверстий, мм\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 11650,\n    \"values\": [\n      {\n        \"value\": \"1\"\n      }\n    ],\n    \"_name\": \"原厂包装数量\",\n    \"_source\": \"系统默认：原厂包装数量 1\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4383,\n    \"values\": [\n      {\n        \"value\": \"1050\"\n      }\n    ],\n    \"_name\": \"商品重量，克\",\n    \"_source\": \"自动工作台：商品净重\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9710,\n    \"values\": [\n      {\n        \"value\": \"450\"\n      }\n    ],\n    \"_name\": \"喷口长度，mm\",\n    \"_source\": \"Длина излива, мм\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4191,\n    \"values\": [\n      {\n        \"value\": \"Кухонный смеситель с гибким изливом выполнен из нержавеющей стали и ABS-пластика. Серое износостойкое покрытие устойчиво к царапинам и перепадам температур. Гибкий излив поворачивается в нужную сторону, помогая направлять поток воды под удобным углом при работе с мойками разной формы и глубины. Рычажное управление позволяет регулировать температуру и напор воды. Смеситель оснащён керамическим картриджем, устанавливается в одно монтажное отверстие и крепится на гайке. В комплекте заявлены необходимые крепления для монтажа. Расход воды — 8 л/мин.\"\n      }\n    ],\n    \"_name\": \"简介\",\n    \"_source\": \"生成文案\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 4497,\n    \"values\": [\n      {\n        \"value\": \"1030\"\n      }\n    ],\n    \"_name\": \"含包装重量，克\",\n    \"_source\": \"Вес с упаковкой, г\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10400,\n    \"values\": [\n      {\n        \"value\": \"1 年\",\n        \"dictionary_value_id\": 970716397\n      }\n    ],\n    \"_name\": \"保证\",\n    \"_source\": \"系统默认：保证 1 年（Ozon 实时字典）\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9715,\n    \"values\": [\n      {\n        \"value\": \"灵活\",\n        \"dictionary_value_id\": 970585239\n      }\n    ],\n    \"_name\": \"喷口执行\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9703,\n    \"values\": [\n      {\n        \"value\": \"杠杆\",\n        \"dictionary_value_id\": 970585172\n      }\n    ],\n    \"_name\": \"控制\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10573,\n    \"values\": [\n      {\n        \"value\": \"1\",\n        \"dictionary_value_id\": 970729508\n      }\n    ],\n    \"_name\": \"水龙头孔\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 10393,\n    \"values\": [\n      {\n        \"value\": \"陶瓷滤芯\",\n        \"dictionary_value_id\": 970715755\n      }\n    ],\n    \"_name\": \"混合器截止阀\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 9707,\n    \"values\": [\n      {\n        \"value\": \"最新的\",\n        \"dictionary_value_id\": 970585210\n      }\n    ],\n    \"_name\": \"风格\",\n    \"_source\": \"AI选择 + Ozon实时字典校验\"\n  },\n  {\n    \"complex_id\": 0,\n    \"id\": 11