            "category_dependent": true,
            "complex_is_collection": false,
            "name_ru": "ТН ВЭД коды ЕАЭС",
            "description_ru": "Выберите одно значение из списка. Если вы не знаете, какой код нужно указать, то вам необходимо обратиться к таможенной службе или таможенному представителю",
            "group_name_ru": ""
          },
          {
            "id": 10097,
            "attribute_complex_id": 0,
            "name": "颜色名称",
            "description": "颜色的文字说明-填写它，如果产品有来自供应商的颜色的营销名称，色调或阴影的数量，例如：\"17号细腻的蓝色azure\"，\"深蓝色\"",
