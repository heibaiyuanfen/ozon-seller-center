            "dictionary_id": 0,
            "category_dependent": false,
            "complex_is_collection": false,
            "name_ru": "Общее количество, шт",
            "description_ru": "Если продаёте несколько упаковок, укажите общее количество во всех упаковках. Например, если продаёте 2 упаковки по 5 единиц товара, укажите 10",
            "group_name_ru": "Основные"
          },
          {
            "id": 6456,
            "attribute_complex_id": 0,
            "name": "用途",
            "description": "请从列表中选择或手动输入。您可以添加多个值，并以分号（；）来分隔。如果属性值中包含分号，那么请将该符号置于双引号中（如“；”）。",
            "type": "String",
            "is_collection": true,
            "is_required": false,
            "is_aspect": false,
            "max_value_count": 0,
            "group_name": "主要信息",
